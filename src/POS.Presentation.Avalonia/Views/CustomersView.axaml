<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             xmlns:customers="using:POS.Application.DTOs.Customers"
             x:Class="POS.Presentation.Avalonia.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="20">
    <StackPanel Spacing="4">
      <TextBlock Text="Clientes" FontSize="34" FontWeight="Bold" Foreground="#0F172A" />
      <TextBlock Text="Registra clientes, actualiza sus datos y consulta su historial operativo." Foreground="#475569" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,1*,1.1*" ColumnSpacing="18">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <TextBlock Text="Buscar cliente" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Nombre, documento, teléfono o correo" />
            <Button Grid.Column="1" Classes="secondary" Content="Buscar" Command="{Binding LoadCommand}" />
          </Grid>
          <CheckBox Grid.Row="2" IsChecked="{Binding IncludeInactive, Mode=TwoWay}" Content="Mostrar clientes inactivos" />
          <ListBox Grid.Row="3" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="customers:CustomerSearchResult">
                <Border Padding="10" Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding Identification}" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding Phone}" Foreground="#64748B" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Datos del cliente" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
          <TextBox Text="{Binding FullName, Mode=TwoWay}" PlaceholderText="Nombre completo" />
          <TextBox Text="{Binding Identification, Mode=TwoWay}" PlaceholderText="Documento o identificación" />
          <TextBox Text="{Binding Phone, Mode=TwoWay}" PlaceholderText="Teléfono" />
          <TextBox Text="{Binding Email, Mode=TwoWay}" PlaceholderText="Correo" />
          <TextBox Text="{Binding Address, Mode=TwoWay}" PlaceholderText="Dirección" />
          <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Content="Cliente activo" />
          <Button Classes="primary" Content="Guardar cliente" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Historial" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <Button Grid.Column="1" Classes="secondary" Content="Ver historial" Command="{Binding OpenHistoryCommand}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="Ventas y movimientos persistidos vinculados al cliente seleccionado." Foreground="#64748B" TextWrapping="Wrap" />
          <ItemsControl Grid.Row="2" ItemsSource="{Binding HistoryEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="customers:CustomerHistoryEntry">
                <Border Padding="10" Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Grid.Column="1" Text="{Binding Amount}" Foreground="#334155" />
                    <TextBlock Grid.Row="1" Text="{Binding Kind}" Foreground="#64748B" FontSize="12" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status}" Foreground="#64748B" FontSize="12" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
