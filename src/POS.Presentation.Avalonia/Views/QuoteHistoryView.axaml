<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             xmlns:quotes="using:POS.Presentation.Shared.Quotes"
             x:Class="POS.Presentation.Avalonia.Views.QuoteHistoryView"
             x:DataType="vm:QuoteHistoryViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Filters -->
    <Border Classes="card">
      <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10">
        <TextBox Text="{Binding FilterCustomerName, Mode=TwoWay}" PlaceholderText="Filtrar por cliente" />
        <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFrom, Mode=TwoWay}" />
        <DatePicker Grid.Column="2" SelectedDate="{Binding FilterTo, Mode=TwoWay}" />
        <Button Grid.Column="4" Classes="primary" Content="Buscar" Command="{Binding LoadCommand}" />
      </Grid>
    </Border>

    <!-- Status message -->
    <Border Grid.Row="1" Background="#F0F9FF" CornerRadius="8" Padding="10" Margin="0,10,0,0"
            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#0369A1" TextWrapping="Wrap" />
    </Border>

    <!-- Quote list -->
    <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
      <Grid RowDefinitions="Auto,*">
        <!-- Column headers -->
        <Border Background="#EEF2FF" CornerRadius="8" Padding="10">
          <Grid ColumnDefinitions="120,*,140,100,100,80,80">
            <TextBlock Text="Número" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="1" Text="Cliente" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="2" Text="Total" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="3" Text="Estado" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="4" Text="Vence" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="5" Text="Enviar" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock Grid.Column="6" Text="Convertir" FontWeight="SemiBold" Foreground="#334155" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" MaxHeight="400">
          <ItemsControl ItemsSource="{Binding Quotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="quotes:QuoteSummaryRow">
                <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="120,*,140,100,100,80,80">
                    <TextBlock Text="{Binding QuoteNumber}" Foreground="#0F172A" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding CustomerName}" Foreground="#0F172A" />
                      <TextBlock Text="{Binding CustomerEmail}" Foreground="#64748B" FontSize="11"
                                 IsVisible="{Binding CustomerEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TotalFormatted}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" Foreground="#475569" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding ExpiresAt}" Foreground="#475569" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                      <Button Classes="secondary" Content="✉"
                              Command="{Binding $parent[UserControl].((vm:QuoteHistoryViewModel)DataContext).SendByEmailCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="secondary" Content="📱"
                              Command="{Binding $parent[UserControl].((vm:QuoteHistoryViewModel)DataContext).SendByWhatsAppCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                    <Button Grid.Column="6" Classes="primary" Content="→Venta"
                            Command="{Binding $parent[UserControl].((vm:QuoteHistoryViewModel)DataContext).ConvertToSaleCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Pagination -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
      <Button Classes="secondary" Content="← Anterior" Command="{Binding PreviousPageCommand}" />
      <TextBlock VerticalAlignment="Center">
        <Run Text="Página " />
        <Run Text="{Binding CurrentPage}" />
        <Run Text=" — " />
        <Run Text="{Binding TotalCount}" />
        <Run Text=" total" />
      </TextBlock>
      <Button Classes="secondary" Content="Siguiente →" Command="{Binding NextPageCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
