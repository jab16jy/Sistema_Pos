<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             xmlns:enums="using:POS.Domain.Enums"
             x:Class="POS.Presentation.Avalonia.Views.SendDocumentView"
             x:DataType="vm:SendDocumentViewModel">

  <Border Classes="card" MaxWidth="480">
    <StackPanel Spacing="14">

      <TextBlock Text="Enviar documento" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
      <TextBlock Text="Elige el canal y confirma el contacto del destinatario antes de enviar." Foreground="#64748B" />

      <StackPanel Spacing="4">
        <TextBlock Text="Contacto del destinatario" Foreground="#374151" FontSize="13" />
        <TextBox Text="{Binding RecipientContact, Mode=TwoWay}"
                 PlaceholderText="Email o número de teléfono" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Canal de envío" Foreground="#374151" FontSize="13" />
        <ComboBox SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" HorizontalAlignment="Stretch">
          <enums:SendChannel>Email</enums:SendChannel>
          <enums:SendChannel>WhatsApp</enums:SendChannel>
        </ComboBox>
      </StackPanel>

      <Button Classes="primary"
              Content="Enviar"
              Command="{Binding SendCommand}"
              IsEnabled="{Binding !IsSending}"
              HorizontalAlignment="Stretch" />

      <TextBlock Text="{Binding ResultMessage}"
                 Foreground="#475569"
                 TextWrapping="Wrap"
                 FontSize="12"
                 IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    </StackPanel>
  </Border>

</UserControl>
