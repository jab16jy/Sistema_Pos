<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             xmlns:quotes="using:POS.Presentation.Shared.Quotes"
             xmlns:products="using:POS.Application.DTOs.Products"
             x:Class="POS.Presentation.Avalonia.Views.QuoteView"
             x:DataType="vm:QuoteViewModel">

  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">

      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Nueva Cotización" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="Busca productos, agrega al carrito y confirma para crear la cotización." Foreground="#64748B" />
      </StackPanel>

      <!-- Customer and search -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,18,0,0">

        <!-- Left: product search -->
        <Border Classes="card">
          <Grid RowDefinitions="Auto,Auto,150,Auto">
            <TextBlock Text="Productos" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,8">
              <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Buscar por nombre o código" />
              <Button Grid.Column="1" Classes="secondary" Content="Buscar" Command="{Binding SearchCommand}" />
            </Grid>

            <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" MinHeight="100">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="products:ProductLookupResult">
                  <Grid ColumnDefinitions="*,120" Margin="4">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="#0F172A" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Barcode}" Foreground="#64748B" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding UnitPrice}" Foreground="#334155" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="3" Classes="primary" Content="Agregar al carrito"
                    Command="{Binding AddToCartCommand}" Margin="0,10,0,0" />
          </Grid>
        </Border>

        <!-- Right: customer info -->
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Datos del cliente" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBox Text="{Binding CustomerName, Mode=TwoWay}" PlaceholderText="Nombre del cliente *" />
            <TextBox Text="{Binding CustomerPhone, Mode=TwoWay}" PlaceholderText="Teléfono (WhatsApp)" />
            <TextBox Text="{Binding CustomerEmail, Mode=TwoWay}" PlaceholderText="Correo electrónico" />
            <NumericUpDown Minimum="1" Maximum="365" Value="{Binding ValidityDays, Mode=TwoWay}" />
            <TextBox Text="{Binding Observations, Mode=TwoWay}" PlaceholderText="Observaciones" AcceptsReturn="True" MaxHeight="80" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Cart and confirm -->
      <Border Grid.Row="2" Classes="card" Margin="0,18,0,0">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="Carrito de cotización" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />

          <ScrollViewer Grid.Row="1" MaxHeight="200" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding CartItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="quotes:QuoteCartItemViewModel">
                  <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,80,100,100,Auto">
                      <TextBlock Text="{Binding ProductName}" Foreground="#0F172A" />
                      <NumericUpDown Grid.Column="1" Minimum="0.01" Value="{Binding Quantity, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding UnitPrice}" Foreground="#334155" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Subtotal}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="4" Classes="secondary" Content="✕"
                              Command="{Binding $parent[UserControl].((vm:QuoteViewModel)DataContext).RemoveFromCartCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="Total" Foreground="#64748B" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TotalFormatted}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" />
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Classes="primary" Content="Confirmar cotización"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding !IsConfirming}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </ScrollViewer>
</UserControl>
