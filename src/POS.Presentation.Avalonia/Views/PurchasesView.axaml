<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             xmlns:purchases="using:POS.Application.DTOs.Purchases"
             x:Class="POS.Presentation.Avalonia.Views.PurchasesView"
             x:DataType="vm:PurchasesViewModel">
  <Grid ColumnDefinitions="1.1*,1.2*" ColumnSpacing="20">
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Text="Proveedor" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
        <TextBox Text="{Binding SupplierSearchText, Mode=TwoWay}" PlaceholderText="Buscar proveedor" />
        <Button Classes="secondary" Content="Buscar proveedores" Command="{Binding LoadCommand}" />
        <ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" MinHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="purchases:SupplierSearchResult">
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock Text="{Binding TaxId}" Foreground="#64748B" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Registrar proveedor" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
        <TextBox Text="{Binding SupplierName, Mode=TwoWay}" PlaceholderText="Nombre del proveedor" />
        <TextBox Text="{Binding SupplierTaxId, Mode=TwoWay}" PlaceholderText="NIT o identificación" />
        <TextBox Text="{Binding SupplierPhone, Mode=TwoWay}" PlaceholderText="Teléfono" />
        <TextBox Text="{Binding SupplierEmail, Mode=TwoWay}" PlaceholderText="Correo" />
        <Button Classes="primary" Content="Guardar proveedor" Command="{Binding SaveSupplierCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Text="Compra" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="Registra los productos comprados. La confirmación actualiza inventario desde Application." Foreground="#64748B" TextWrapping="Wrap" />
        <TextBox Text="{Binding DraftProductId, Mode=TwoWay}" PlaceholderText="Id del producto" />
        <NumericUpDown Minimum="1" Value="{Binding DraftQuantity, Mode=TwoWay}" />
        <NumericUpDown Minimum="0" Value="{Binding DraftTotalCost, Mode=TwoWay}" />
        <Button Classes="secondary" Content="Agregar producto" Command="{Binding AddDraftItemCommand}" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="purchases:PurchaseDraftItem">
              <Border Background="#F8FAFC" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,90,120">
                  <TextBlock Text="{Binding ProductId}" Foreground="#334155" />
                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#334155" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalCost}" Foreground="#0F172A" FontWeight="SemiBold" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="primary" Content="Registrar compra" Command="{Binding RegisterPurchaseCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding Message}" Foreground="#64748B" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
