<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Presentation.Shared.ViewModels"
             x:Class="POS.Presentation.Avalonia.Views.ReceivablesView"
             x:DataType="vm:ReceivablesViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

    <!-- Header -->
    <Border Classes="card" Grid.Row="0">
      <StackPanel Spacing="8">
        <TextBlock Text="Cuentas por Cobrar" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="Consulta y registra abonos a los saldos pendientes de clientes." Foreground="#64748B" TextWrapping="Wrap" />
        <Button Classes="secondary" Content="Actualizar lista" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <!-- Receivables list -->
    <Border Classes="card" Grid.Row="1">
      <ListBox ItemsSource="{Binding Receivables}" SelectedItem="{Binding SelectedReceivable, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReceivableSummaryRow">
            <Border Background="#F8FAFC" CornerRadius="10" Padding="10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" Foreground="#0F172A" />
                  <TextBlock Text="{Binding InvoiceNumber}" Foreground="#64748B" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0">
                  <TextBlock Text="{Binding OutstandingBalance, StringFormat='${0:N0}'}" Foreground="#DC2626" FontWeight="Bold" />
                  <TextBlock Text="{Binding OriginalBalance, StringFormat='Total: ${0:N0}'}" Foreground="#64748B" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yy}'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Payment entry -->
    <Border Classes="card" Grid.Row="2">
      <StackPanel Spacing="12">
        <TextBlock Text="Registrar abono" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
        <NumericUpDown Minimum="0" Value="{Binding PaymentAmount, Mode=TwoWay}" PlaceholderText="Monto del abono" FormatString="N0" />
        <Button Classes="primary" Content="Aplicar abono" Command="{Binding ApplyPaymentCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
