<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBackground">#FFFFFF</Color>
  <Color x:Key="ColorSurface">#FFFFFF</Color>
  <Color x:Key="ColorSurfaceContainer">#F4F4F5</Color>
  <Color x:Key="ColorSurfaceAlt">#E8EAED</Color>
  <Color x:Key="ColorPrimary">#0369A1</Color>
  <Color x:Key="ColorPrimaryDark">#075985</Color>
  <Color x:Key="ColorPrimaryContainer">#E0F2FE</Color>
  <Color x:Key="ColorPrimaryAction">#66A3C2</Color>
  <Color x:Key="ColorAccent">#0F766E</Color>
  <Color x:Key="ColorAccentAction">#579F9A</Color>
  <Color x:Key="ColorSecondaryContainer">#CCFBF1</Color>
  <Color x:Key="ColorSidebar">#1E293B</Color>
  <Color x:Key="ColorText">#18181B</Color>
  <Color x:Key="ColorButtonText">#000000</Color>
  <Color x:Key="ColorMuted">#71717A</Color>
  <Color x:Key="ColorBorder">#D4D4D8</Color>
  <Color x:Key="ColorDanger">#DC2626</Color>
  <Color x:Key="ColorDangerSoft">#FEE2E2</Color>
  <Color x:Key="ColorSuccess">#16A34A</Color>
  <Color x:Key="ColorSuccessContainer">#DCFCE7</Color>
  <Color x:Key="ColorWarning">#D97706</Color>
  <Color x:Key="ColorWarningContainer">#FEF3C7</Color>
  <Color x:Key="ColorCard">#FFFFFF</Color>

  <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BrushSurfaceContainer" Color="{StaticResource ColorSurfaceContainer}" />
  <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
  <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="BrushPrimaryDark" Color="{StaticResource ColorPrimaryDark}" />
  <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{StaticResource ColorPrimaryContainer}" />
  <SolidColorBrush x:Key="BrushPrimaryAction" Color="{StaticResource ColorPrimaryAction}" />
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="BrushAccentAction" Color="{StaticResource ColorAccentAction}" />
  <SolidColorBrush x:Key="BrushSecondaryContainer" Color="{StaticResource ColorSecondaryContainer}" />
  <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
  <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="BrushButtonText" Color="{StaticResource ColorButtonText}" />
  <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="BrushDangerSoft" Color="{StaticResource ColorDangerSoft}" />
  <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="BrushSuccessContainer" Color="{StaticResource ColorSuccessContainer}" />
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="BrushWarningContainer" Color="{StaticResource ColorWarningContainer}" />
  <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />

  <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource ColorPrimaryContainer}" />
  <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
  <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{StaticResource ColorSecondaryContainer}" />
  <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#115E59" />
</ResourceDictionary>
