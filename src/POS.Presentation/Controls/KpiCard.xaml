<UserControl x:Class="POS.Presentation.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Border Style="{StaticResource Card}" MinHeight="96">
    <StackPanel>
      <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource MutedText}" FontSize="12" />
      <TextBlock Text="{Binding Value, ElementName=Root}" Style="{StaticResource TextH1}" FontWeight="Bold" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
    </StackPanel>
  </Border>
</UserControl>
