<UserControl x:Class="POS.Presentation.Controls.SubtabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="40">
  <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Content="{Binding}"
                       GroupName="{Binding GroupName, ElementName=Root}"
                       Style="{StaticResource SubtabItemStyle}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
