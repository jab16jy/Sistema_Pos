<Window x:Class="POS.Presentation.Views.QuoteDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Detalle de cotización"
        Width="420"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushSurface}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding QuoteNumber}" FontFamily="Consolas" Style="{StaticResource TextH2}" FontWeight="Bold" />
        <TextBlock Text="{Binding CustomerName}" FontWeight="Medium" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock Text="Vence" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding ExpiresAt}" Style="{StaticResource TextBody}" HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>

    <Border x:Name="ContactInfoBorder" Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="{Binding CustomerEmail}" Style="{StaticResource MutedText}" FontSize="12"
                    Visibility="{Binding CustomerEmail, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
        <TextBlock Text="{Binding CustomerPhone}" Style="{StaticResource MutedText}" FontSize="12"
                    Visibility="{Binding CustomerPhone, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ProductName}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:C0}}" FontWeight="Bold" FontFamily="Consolas" Margin="8,0,0,0" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" FontSize="11">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:N0} x {1:C0} · Desc. {2:N0}%">
                      <Binding Path="Quantity" />
                      <Binding Path="UnitPrice" />
                      <Binding Path="Discount" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,10,0,10">
      <Grid>
        <TextBlock Text="Total" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Bottom" />
        <TextBlock Text="{Binding Total, StringFormat={}{0:C0}}" Style="{StaticResource TextH1}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <Button Grid.Row="4" Content="Cerrar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OnCloseClick" />
  </Grid>
</Window>
