<UserControl x:Class="POS.Presentation.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="BackupView_OnLoaded">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <materialDesign:PackIcon Kind="Backup" Width="22" Height="22" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
        <TextBlock Text="Respaldos" Style="{StaticResource TextH3}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="Crea copias de seguridad de la base de datos y restáuralas desde un archivo." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Backup + restore actions -->
        <Border Style="{StaticResource Card}">
          <StackPanel Margin="14">
            <TextBlock Text="Backup manual" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Requiere haber guardado la configuración del negocio al menos una vez." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

            <TextBlock Text="Carpeta de respaldo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding BackupDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="C:\Respaldos\POS" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Examinar" Click="BrowseBackupFolder_OnClick" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackupCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Margin="0,0,4,0" />
                  <TextBlock Text="Exportar respaldo" />
                </StackPanel>
              </Button>
              <Button Click="RestoreBackup_OnClick" IsEnabled="{Binding CanRestore}" ToolTip="Reemplaza los datos actuales con un archivo de respaldo (.db)">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Margin="0,0,4,0" />
                  <TextBlock Text="Restaurar respaldo" />
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Last successful backup -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel Margin="14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <materialDesign:PackIcon Kind="ShieldCheck" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
              <TextBlock Text="Último respaldo exitoso" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding LastBackupTimestampUtc}" Style="{StaticResource TextSmall}" />
            <TextBlock Text="{Binding LastBackupSize}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding LastBackupLocation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding LastBackupOperator, StringFormat=Operador: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
