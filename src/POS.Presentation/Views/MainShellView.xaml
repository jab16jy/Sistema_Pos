<Window x:Class="POS.Presentation.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema POS Local"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#1F2937" Padding="20">
      <StackPanel>
        <TextBlock Text="POS Local" Foreground="White" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="Elige una tarea para continuar" Foreground="#D1D5DB" Margin="0,4,0,24" />

        <Button Content="Caja" Margin="0,0,0,8" Height="44" />
        <Button Content="Productos" Margin="0,0,0,8" Height="44" />
        <Button Content="Inventario" Margin="0,0,0,8" Height="44" />
        <Button Content="Clientes" Margin="0,0,0,8" Height="44" />
        <Button Content="Proveedores" Margin="0,0,0,8" Height="44" />
        <Button Content="Reportes" Margin="0,0,0,8" Height="44" />
        <Button Content="Configuración" Margin="0,0,0,8" Height="44" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Background="#F9FAFB" Margin="0">
      <StackPanel Margin="32">
        <TextBlock Text="Bienvenido" FontSize="32" FontWeight="SemiBold" Foreground="#111827" />
        <TextBlock Text="Este es el punto de partida. La navegación se conectará a los módulos documentados: Caja, Productos, Inventario, Clientes, Proveedores, Facturas, Reportes, Utilidades y Código de Barras."
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   FontSize="16"
                   Foreground="#374151" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
