<Window x:Class="POS.Presentation.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Esthetic Medical Store"
        Width="1360"
        Height="780"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="ShellTabControl" TargetType="TabControl">
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid Background="{StaticResource BrushBackground}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Background="{StaticResource BrushSidebar}" Padding="24">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                    <TextBlock Text="Esthetic Medical Store"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Operacion simple para tienda estetica y medica."
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                  </StackPanel>

                  <Border DockPanel.Dock="Bottom" Background="#26364D" CornerRadius="10" Padding="14" Margin="0,24,0,0">
                    <StackPanel>
                      <TextBlock Text="Usuario: Admin" Foreground="White" FontWeight="SemiBold" />
                      <TextBlock Text="Atajos visibles en cada modulo." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>

                  <ItemsPresenter KeyboardNavigation.TabIndex="1" />
                </DockPanel>
              </Border>

              <Border Grid.Column="1" Background="{StaticResource BrushBackground}">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  ContentSource="SelectedContent"
                                  Margin="28" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="Background" Value="#E5EAF0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Width" Value="252" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedStripe"
                        Background="Transparent"
                        CornerRadius="3"
                        Margin="0,0,12,0" />
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="#F8FAFC" />
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#BAE6FD" />
                <Setter TargetName="SelectedStripe" Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource BrushPrimaryDark}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="#F1F5F9" />
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#CBD5E1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl Style="{StaticResource ShellTabControl}">
    <TabItem Header="F1  Caja">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Caja" FontSize="34" FontWeight="Bold" />
              <TextBlock Text="Escanea el codigo o escribe el nombre del producto."
                         Style="{StaticResource MutedText}"
                         FontSize="15"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="F6 Cliente" Margin="0,0,10,0" />
              <Button Content="F7 Dejar en espera" />
            </StackPanel>
          </DockPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="7*" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="22">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="Buscar producto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                  <TextBox FontSize="16" ToolTip="Campo activo para teclado o escaner." />
                </DockPanel>

                <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                  <TextBlock Text="Empieza escaneando un codigo o escribiendo el nombre del producto."
                             Foreground="{StaticResource BrushAccent}" />
                </Border>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="60" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.ColumnSpan="5" Background="#E0F2FE" CornerRadius="8" Padding="12" />
                  <TextBlock Text="Producto" FontWeight="SemiBold" Margin="12,10" />
                  <TextBlock Grid.Column="1" Text="Cant." FontWeight="SemiBold" Margin="0,10" />
                  <TextBlock Grid.Column="2" Text="Precio" FontWeight="SemiBold" TextAlignment="Right" Margin="0,10" />
                  <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="SemiBold" TextAlignment="Right" Margin="0,10" />
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,12,0,0">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Aun no hay productos en el carrito." FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Cuando agregues productos apareceran aqui con cantidad, precio y subtotal."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                  </StackPanel>
                </Border>

                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                  <TextBlock Text="Atajos: F5 Cobrar | F6 Cliente | F7 Espera | Esc Cancelar"
                             Foreground="{StaticResource BrushMuted}" />
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#F0FDFA"
                    BorderBrush="#CCFBF1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
              <StackPanel>
                <TextBlock Text="Liquidacion" FontSize="22" FontWeight="Bold" />
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,18,0,14">
                  <StackPanel>
                    <TextBlock Text="TOTAL A PAGAR" Foreground="{StaticResource BrushPrimaryDark}" FontWeight="SemiBold" />
                    <TextBlock Text="$0" FontSize="40" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Metodo de pago" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="Efectivo" />
                  <ComboBoxItem Content="Transferencia" />
                  <ComboBoxItem Content="Tarjeta" />
                </ComboBox>
                <UniformGrid Columns="2" Margin="0,16,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Recibido" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox FontSize="18" />
                  </StackPanel>
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Cambio" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="40">
                      <TextBlock Text="$0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}" />
                    </Border>
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="El sistema calculara el cambio cuando se ingrese el pago."
                           Style="{StaticResource MutedText}"
                           Margin="0,20,0,18" />
                <Button Content="F5 Finalizar venta" Style="{StaticResource AccentButton}" Height="54" FontSize="16" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
            <TextBlock Text="Ayuda: Si aparece 'stock insuficiente', reduce la cantidad o consulta Inventario antes de cobrar."
                       Foreground="#92400E" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="F2  Productos">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Productos" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="Administra los productos que se venden en caja." Style="{StaticResource MutedText}" Margin="0,6,0,22" />

          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+ Nuevo producto" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
              <Button DockPanel.Dock="Right" Content="Importar" Margin="10,0,0,0" />
              <TextBox DockPanel.Dock="Left" Width="260" Margin="0,0,12,0" />
              <ComboBox DockPanel.Dock="Left" Width="210" SelectedIndex="0">
                <ComboBoxItem Content="Todas las categorias" />
                <ComboBoxItem Content="Cuidado facial" />
                <ComboBoxItem Content="Insumos medicos" />
              </ComboBox>
              <TextBlock Text="Busca por codigo, nombre o categoria." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="28">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="No hay productos cargados para mostrar." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Cuando registres productos apareceran en este listado con stock, precio y estado."
                         Style="{StaticResource MutedText}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         Margin="0,8,0,18" />
              <Button Content="+ Crear primer producto" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="F3  Inventario">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Inventario" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="Consulta cantidades, valor del inventario y movimientos." Style="{StaticResource MutedText}" Margin="0,6,0,22" />

          <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Total productos" Style="{StaticResource MutedText}" />
                <TextBlock Text="0" FontSize="30" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Unidades" Style="{StaticResource MutedText}" />
                <TextBlock Text="0" FontSize="30" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Valor en costo" Style="{StaticResource MutedText}" />
                <TextBlock Text="$0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Estado de stock" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                <TextBlock Text="Sin productos registrados. Los estados de stock apareceran aqui cuando exista inventario."
                           Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Ultimos movimientos" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Aun no hay entradas, salidas ni ajustes registrados."
                           Style="{StaticResource MutedText}"
                           Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="F4  Clientes">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Clientes" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="Registra clientes, puntos e historial de compras sin retrasar la fila." Style="{StaticResource MutedText}" Margin="0,6,0,22" />

          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+ Nuevo cliente" Style="{StaticResource PrimaryButton}" />
              <TextBox DockPanel.Dock="Left" Width="320" Margin="0,0,12,0" />
              <TextBlock Text="Busca por nombre, cedula o NIT." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Clientes recientes" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="No hay clientes registrados todavia."
                           Style="{StaticResource MutedText}"
                           Margin="0,16,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Datos personales" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock Text="Nombre" />
                  <TextBox Margin="0,4,0,12" />
                  <TextBlock Text="Cedula o NIT" />
                  <TextBox Margin="0,4,0,12" />
                  <TextBlock Text="Telefono" />
                  <TextBox Margin="0,4,0,12" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="Historial y puntos" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <Border Background="#F0FDFA" CornerRadius="8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Puntos disponibles" Style="{StaticResource MutedText}" />
                      <TextBlock Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="El historial se mostrara cuando el cliente tenga compras registradas."
                             Style="{StaticResource MutedText}"
                             Margin="0,16,0,0" />
                  <Button Content="Guardar cliente" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                </StackPanel>
              </UniformGrid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="F8  Reportes">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Reportes y cierre de caja" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="Revisa ventas, pagos y efectivo fisico antes de cerrar." Style="{StaticResource MutedText}" Margin="0,6,0,22" />

          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Generar reporte" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
              <Button DockPanel.Dock="Right" Content="Exportar PDF" Margin="10,0,0,0" />
              <ComboBox DockPanel.Dock="Left" Width="160" SelectedIndex="0" Margin="0,0,12,0">
                <ComboBoxItem Content="Hoy" />
                <ComboBoxItem Content="Esta semana" />
              </ComboBox>
              <TextBox DockPanel.Dock="Left" Width="160" Margin="0,0,12,0" />
              <TextBox DockPanel.Dock="Left" Width="160" />
            </DockPanel>
          </Border>

          <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Total facturado" Style="{StaticResource MutedText}" />
                <TextBlock Text="$0" FontSize="30" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Background="#F0FDFA" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Efectivo esperado" Style="{StaticResource MutedText}" />
                <TextBlock Text="$0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Background="#EFF6FF">
              <StackPanel>
                <TextBlock Text="Pagos digitales" Style="{StaticResource MutedText}" />
                <TextBlock Text="$0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Resumen del turno" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="No hay ventas registradas para el rango seleccionado."
                           Style="{StaticResource MutedText}"
                           Margin="0,16,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Arqueo de caja" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Efectivo contado" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBox FontSize="18" />
                <Border Background="#DCFCE7" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="Diferencia" Foreground="#166534" />
                    <TextBlock Text="$0" FontSize="28" FontWeight="Bold" Foreground="#166534" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Si hay descuadre, revisa los billetes ingresados antes de cerrar."
                           Style="{StaticResource MutedText}"
                           Margin="0,14,0,20" />
                <Button Content="Cerrar caja" Style="{StaticResource AccentButton}" Height="48" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
