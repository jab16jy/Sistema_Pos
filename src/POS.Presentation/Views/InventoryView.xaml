<UserControl x:Class="POS.Presentation.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="52*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="48*" />
    </Grid.ColumnDefinitions>

    <!-- ══ LEFT COLUMN: KPIs + Stock grid ══ -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- KPI strip -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <UniformGrid Columns="3">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="TOTAL SKUS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TotalSkus}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas" />
          </StackPanel>
          <StackPanel Margin="8,0,8,0">
            <TextBlock Text="STOCK BAJO" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas"
                       Foreground="{StaticResource BrushWarning}" />
          </StackPanel>
          <StackPanel Margin="8,0,0,0">
            <TextBlock Text="SIN STOCK" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OutOfStockCount}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas"
                       Foreground="{StaticResource BrushDanger}" />
          </StackPanel>
        </UniformGrid>
      </Border>

      <!-- Stock grid -->
      <Border Grid.Row="1" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar producto..." />
            <ComboBox Grid.Column="1" SelectedValue="{Binding StatusFilter, Mode=TwoWay}"
                      SelectedValuePath="Tag" Margin="8,0,0,0">
              <ComboBoxItem Content="Todos" Tag="" IsSelected="True" />
              <ComboBoxItem Content="En stock" Tag="ok" />
              <ComboBoxItem Content="Stock bajo" Tag="low" />
              <ComboBoxItem Content="Sin stock" Tag="out" />
            </ComboBox>
            <Button Grid.Column="2" Command="{Binding LoadStockCommand}"
                    Padding="8,0" Margin="8,0,0,0" ToolTip="Exportar CSV">
              <materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
            </Button>
          </Grid>

          <!-- Grid header -->
          <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainer}" Padding="8,6" CornerRadius="4,4,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="PRODUCTO" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="1" Text="STOCK" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="2" Text="ESTADO" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
            </Grid>
          </Border>

          <!-- Stock rows -->
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding FilteredStockLevels}"
                   SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                   BorderThickness="0"
                   Background="Transparent">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>

                  <!-- Product name -->
                  <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                  <!-- Stock bar -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStock}" FontFamily="Consolas" FontWeight="SemiBold"
                               FontSize="12" MinWidth="24" VerticalAlignment="Center" />
                    <Border Height="4" CornerRadius="2" Background="{StaticResource BrushSurfaceContainer}"
                            Margin="6,0,0,0" VerticalAlignment="Center" Width="50">
                      <Border CornerRadius="2" HorizontalAlignment="Left">
                        <Border.Width>
                          <MultiBinding Converter="{StaticResource StockBarWidthConverter}" ConverterParameter="50">
                            <Binding Path="CurrentStock" />
                            <Binding Path="MinimumStock" />
                          </MultiBinding>
                        </Border.Width>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BrushSuccess}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CurrentStock}" Value="0">
                                <Setter Property="Background" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Border>
                  </StackPanel>

                  <!-- Status chip -->
                  <Border Grid.Column="2" Padding="6,2" CornerRadius="3" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CurrentStock}" Value="0">
                            <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="En stock" />
                          <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStock}" Value="0">
                              <Setter Property="Text" Value="Sin stock" />
                              <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>

                  <!-- Quick adjust button -->
                  <Button Grid.Column="3" Command="{Binding DataContext.QuickAdjustCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0" Padding="4"
                          ToolTip="Ajustar stock">
                    <materialDesign:PackIcon Kind="Tune" Width="16" Height="16"
                                              Foreground="{StaticResource BrushMuted}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ══ RIGHT COLUMN: Adjustment + Movements ══ -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Adjustment panel -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <!-- Header -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20"
                                      Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Ajuste de stock" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="2" Padding="6,2" CornerRadius="3">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                      <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding SelectedProductChipLabel}" FontSize="11" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </Grid>

          <!-- Quantity: sign + input -->
          <TextBlock Text="Cantidad" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sign toggle -->
            <Button Command="{Binding ToggleSignCommand}" Padding="0" Height="48" Margin="0,0,8,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                  <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                  <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdjustmentPositive}" Value="False">
                      <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                      <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock FontSize="24" FontWeight="Bold" FontFamily="Consolas">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="+" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAdjustmentPositive}" Value="False">
                        <Setter Property="Text" Value="-" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>

            <!-- Quantity input -->
            <TextBox Grid.Column="1" Text="{Binding AdjustmentQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="24" FontWeight="Bold" FontFamily="Consolas"
                     HorizontalContentAlignment="Center" Height="48" />
          </Grid>

          <!-- Preview -->
          <TextBlock Margin="0,0,0,8" HorizontalAlignment="Center"
                     Visibility="{Binding HasAdjustmentPreview, Converter={StaticResource BoolToVisibilityConverter}}">
            <Run Text="Stock actual: " />
            <Run Text="{Binding AdjustmentPreviewCurrent, Mode=OneWay}" FontWeight="Bold" />
            <Run Text=" -> Nuevo stock: " />
            <Run FontWeight="Bold">
              <Run.Text>
                <Binding Path="AdjustmentPreviewNew" Mode="OneWay" />
              </Run.Text>
            </Run>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!-- Reason -->
          <TextBlock Text="Motivo *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
          <ComboBox SelectedValue="{Binding AdjustmentReason, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
            <ComboBoxItem Content="Selecciona un motivo" Tag="" IsSelected="True" IsEnabled="False" />
            <ComboBoxItem Content="Conteo fisico" Tag="Conteo fisico" />
            <ComboBoxItem Content="Producto danado" Tag="Producto danado" />
            <ComboBoxItem Content="Devolucion de compra" Tag="Devolucion de compra" />
            <ComboBoxItem Content="Muestra / uso interno" Tag="Muestra / uso interno" />
            <ComboBoxItem Content="Otro" Tag="Otro" />
          </ComboBox>

          <!-- Note -->
          <TextBlock Text="Nota (opcional)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
          <TextBox Text="{Binding AdjustmentNote, Mode=TwoWay}" Tag="Detalle del ajuste..."
                   AcceptsReturn="True" Height="64" Margin="0,0,0,12" />

          <!-- Actions -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding AdjustStockCommand}" Style="{StaticResource PrimaryButton}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Aplicar ajuste" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding ClearAdjustmentCommand}"
                    Background="Transparent" BorderThickness="0" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Limpiar" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Movements panel -->
      <Border Grid.Row="1" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="History" Width="20" Height="20"
                                      Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Historial de movimientos" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" SelectedValue="{Binding MovementTypeFilter, Mode=TwoWay}"
                      SelectedValuePath="Tag">
              <ComboBoxItem Content="Todo tipo" Tag="" IsSelected="True" />
              <ComboBoxItem Content="Entradas" Tag="Entry" />
              <ComboBoxItem Content="Salidas" Tag="Exit" />
              <ComboBoxItem Content="Ajustes" Tag="Adjustment" />
            </ComboBox>
          </Grid>

          <!-- Movement list -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredMovements}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>

                      <!-- Type icon -->
                      <Border Width="32" Height="32" CornerRadius="16">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Entry">
                                <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Exit">
                                <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                              <Setter Property="Kind" Value="SwapVertical" />
                              <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="Entry">
                                  <Setter Property="Kind" Value="ArrowDown" />
                                  <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Exit">
                                  <Setter Property="Kind" Value="ArrowUp" />
                                  <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                      </Border>

                      <!-- Info -->
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                          <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat='{}{0:HH:mm}'}" />
                          <Run Text=" -> stock: " />
                          <Run Text="{Binding Quantity, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>

                      <!-- Delta -->
                      <TextBlock Grid.Column="2" FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                                 TextAlignment="Right" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Exit">
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Quantity, Mode=OneWay, StringFormat='{}{0:+#;-#;0}'}" />
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Empty state -->
          <TextBlock Grid.Row="1" Text="Sin movimientos" Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding FilteredMovements.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
