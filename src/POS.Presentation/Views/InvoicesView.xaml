<UserControl x:Class="POS.Presentation.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Facturas" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Buscar ventas" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Número de factura, cliente" Margin="0,0,0,8" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Desde" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="Hasta" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <Button Content="Buscar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
          <ListBox ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}" MaxHeight="500">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" />
                    <Run Text=" - $" />
                    <Run Text="{Binding Total, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding CustomerName}" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                    <Run Text="{Binding Status, Mode=OneWay}" />
                    <Run Text=" | " />
                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Acciones" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Button Content="Reimprimir recibo" Command="{Binding ReprintCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
          <TextBlock Text="Procesar devolución" FontWeight="SemiBold" Margin="0,12,0,8" />
          <TextBox Text="{Binding ReturnReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Razón de la devolución" AcceptsReturn="True" Height="70" Margin="0,0,0,8" />
          <Button Content="Procesar devolución" Command="{Binding ProcessReturnCommand}" />
          <TextBlock Text="La devolución restaurará el stock de todos los productos de la venta." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
