<Window x:Class="POS.Presentation.Views.NavigationShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:POS.Presentation.Controls"
        xmlns:local="clr-namespace:POS.Presentation.Views"
        xmlns:shell="clr-namespace:POS.Presentation.Shared.Shell;assembly=POS.Presentation.Shared"
        Title="Esthetic POS"
        Width="1360"
        Height="780"
        MinWidth="1280"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="F1" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding FuncbarModules[0]}" />
    <KeyBinding Key="F4" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding FuncbarModules[1]}" />
    <KeyBinding Key="F6" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding FuncbarModules[2]}" />
    <KeyBinding Key="F8" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding FuncbarModules[3]}" />
    <KeyBinding Key="F12" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding FuncbarModules[4]}" />
  </Window.InputBindings>

  <DockPanel Background="{StaticResource BrushBackground}">
    <Border DockPanel.Dock="Top" Style="{StaticResource TopbarChrome}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource BrushPrimary}" Margin="0,0,8,0" />
          <TextBlock Text="Esthetic POS" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding SelectedModule.Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrushPrimaryContainer}" Margin="0,0,8,0">
            <TextBlock Text="OP" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding OperatorDisplayName}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock x:Name="ClockTextBlock" Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="Cerrar sesión"
                  Command="{Binding LogoutCommand}"
                  Padding="10,5"
                  FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Height="44"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,1,0,0">
      <ListBox ItemsSource="{Binding FuncbarModules}"
               SelectedItem="{Binding CurrentFuncbarModule, Mode=TwoWay}"
               ItemContainerStyle="{StaticResource FuncbarItem}"
               Background="Transparent"
               BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               VerticalContentAlignment="Stretch">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type shell:ModuleNavigationItem}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource ChipStyle}" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Shortcut}" Style="{StaticResource MonoText}" FontSize="11" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="20" x:Name="ShellContent">
        <Grid Visibility="{Binding IsCashierSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type shell:DashboardMetric}">
                <controls:KpiCard Label="{Binding Label}" Value="{Binding Value}" Hint="{Binding Hint}" Margin="0,0,12,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <local:CashierView Grid.Row="1" DataContext="{Binding Cashier}" />
        </Grid>

        <Grid Visibility="{Binding IsAdminHubSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Centro de control" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{Binding OperatorMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
          </StackPanel>

          <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:KpiCard Label="Módulos activos" Value="7" Hint="Operación y administración" Margin="0,0,12,0" />
            <controls:KpiCard Label="Shell" Value="5" Hint="Accesos directos en funcbar" Margin="0,0,12,0" />
            <controls:KpiCard Label="Atajo Admin" Value="F12" Hint="Abre este centro" Margin="0,0,12,0" />
            <controls:KpiCard Label="Cuentas por cobrar" Value="Oculto" Hint="Backend conservado" />
          </UniformGrid>

          <UniformGrid Grid.Row="2" Columns="3">
            <controls:QuickLink TitleText="Productos" Subtitle="Catálogo, precios y stock mínimo" IconKind="PackageVariant" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[0]}" Margin="0,0,12,12" />
            <controls:QuickLink TitleText="Inventario" Subtitle="Existencias y movimientos" IconKind="Warehouse" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[1]}" Margin="0,0,12,12" />
            <controls:QuickLink TitleText="Compras" Subtitle="Proveedores y compras" IconKind="Cart" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[2]}" Margin="0,0,0,12" />
            <controls:QuickLink TitleText="Reportes" Subtitle="Ventas, caja y utilidades" IconKind="ChartBox" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[3]}" Margin="0,0,12,12" />
            <controls:QuickLink TitleText="Turnos" Subtitle="Apertura y cierre de caja" IconKind="ClockOutline" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[4]}" Margin="0,0,12,12" />
            <controls:QuickLink TitleText="Puntos" Subtitle="Lealtad y redenciones" IconKind="StarCircle" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[5]}" Margin="0,0,0,12" />
            <controls:QuickLink TitleText="Códigos de barras" Subtitle="Generador e impresión de etiquetas" IconKind="BarcodeScan" Command="{Binding SelectModuleCommand}" CommandParameter="{Binding AdminHubModules[6]}" Margin="0,0,12,0" />
            <Border Style="{StaticResource Card}" Background="{StaticResource BrushSurfaceContainer}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Usuarios y permisos" FontWeight="SemiBold" />
                <TextBlock Text="Se mantiene fuera del wireframe; no es enlace de esta fase." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Background="{StaticResource BrushSurfaceContainer}">
              <StackPanel>
                <TextBlock Text="Auditoría operativa" FontWeight="SemiBold" />
                <TextBlock Text="Placeholder administrativo sin navegación directa." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>

        <Grid Visibility="{Binding IsShiftsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:ShiftsView DataContext="{Binding Shifts}" Visibility="{Binding Shifts, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Shifts, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Gestión de turnos no disponible en este entorno." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsUsersSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:UserManagementView DataContext="{Binding UserManagement}" Visibility="{Binding UserManagement, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding UserManagement, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Gestión de usuarios no disponible en este entorno." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsAuditSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:AuditLogView DataContext="{Binding AuditLog}" Visibility="{Binding AuditLog, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding AuditLog, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Auditoría no disponible en este entorno." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsQuotesSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:QuoteView DataContext="{Binding Quote}"
                            HistoryViewModel="{Binding DataContext.QuoteHistory, ElementName=ShellContent}"
                            Visibility="{Binding Quote, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Quote, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Quote creation is not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsCustomersSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:CustomersView DataContext="{Binding Customers}" Visibility="{Binding Customers, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Customers, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Customer management is not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsPurchasesSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:PurchasesView DataContext="{Binding Purchases}" Visibility="{Binding Purchases, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Purchases, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Purchases are not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsReportsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:ReportsView DataContext="{Binding Reports}" Visibility="{Binding Reports, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Reports, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Reports are not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsProductsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:ProductsView DataContext="{Binding Products}" Visibility="{Binding Products, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Products, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Products are not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsInventorySelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:InventoryView DataContext="{Binding Inventory}" Visibility="{Binding Inventory, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Inventory, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Inventory is not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsInvoicesSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:InvoicesView DataContext="{Binding Invoices}" Visibility="{Binding Invoices, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Invoices, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Invoices are not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:SettingsView DataContext="{Binding Settings}" Visibility="{Binding Settings, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Settings, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Settings are not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsLoyaltySelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:LoyaltyView DataContext="{Binding Loyalty}" Visibility="{Binding Loyalty, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Loyalty, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Loyalty module is not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsBarcodeSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <local:BarcodeView DataContext="{Binding Barcode}" Visibility="{Binding Barcode, Converter={StaticResource NullToVisibilityConverter}}" />
          <Border Style="{StaticResource Card}" Visibility="{Binding Barcode, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <TextBlock Text="Barcode module is not available in this environment." Style="{StaticResource MutedText}" />
          </Border>
        </Grid>

        <Grid Visibility="{Binding IsPlannedModuleSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel>
              <TextBlock Text="{Binding SelectedModule.Title}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="This module is planned for a later implementation slice." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SelectedModule.Description}" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
