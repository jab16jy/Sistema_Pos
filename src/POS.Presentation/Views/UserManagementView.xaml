<UserControl x:Class="POS.Presentation.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <!-- Left: user list -->
    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Usuarios del sistema" Style="{StaticResource TextH2}" FontWeight="Bold" />
            <TextBlock Text="Administra accesos, contraseñas y roles." Style="{StaticResource MutedText}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Actualizar lista" Command="{Binding LoadUsersCommand}"
                  Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
        </Grid>

        <DataGrid ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  MaxHeight="400">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*" />
            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="120" />
            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanNegationToVisibilityConverter}}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Right: forms -->
    <StackPanel Grid.Column="1">
      <!-- Create new user -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Nuevo usuario" Style="{StaticResource TextH3}" FontWeight="Bold" Margin="0,0,0,12" />

          <TextBlock Text="Nombre de usuario" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

          <TextBlock Text="Contraseña (mín. 4 caracteres)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <PasswordBox x:Name="NewPasswordBox" Padding="8,6" Margin="0,0,0,10"
                       PasswordChanged="NewPasswordBox_PasswordChanged" />

          <TextBlock Text="Rol" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding AvailableRoles}"
                    SelectedItem="{Binding NewRole, Mode=TwoWay}"
                    Padding="8,6" Margin="0,0,0,14" />

          <Button Content="Crear usuario" Command="{Binding CreateUserCommand}"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </Border>

      <!-- Edit selected user -->
      <Border Style="{StaticResource Card}"
              Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="{Binding SelectedUser.Username, StringFormat='Editar: {0}'}"
                     Style="{StaticResource TextH3}" FontWeight="Bold" Margin="0,0,0,4" />
          <TextBlock Text="Deja la contraseña vacía para no cambiarla."
                     Style="{StaticResource MutedText}" Margin="0,0,0,12" />

          <TextBlock Text="Nueva contraseña (opcional)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <PasswordBox x:Name="EditPasswordBox" Padding="8,6" Margin="0,0,0,10"
                       PasswordChanged="EditPasswordBox_PasswordChanged" />

          <TextBlock Text="Rol" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding AvailableRoles}"
                    SelectedItem="{Binding EditRole, Mode=TwoWay}"
                    Padding="8,6" Margin="0,0,0,14" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Guardar cambios" Command="{Binding SaveEditCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Desactivar usuario" Command="{Binding DeactivateCommand}"
                    Background="{StaticResource BrushDanger}" Foreground="White" BorderThickness="0"
                    Padding="12,8" Cursor="Hand" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
