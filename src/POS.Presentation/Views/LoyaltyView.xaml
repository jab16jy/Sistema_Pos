<UserControl x:Class="POS.Presentation.Views.LoyaltyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushAccent" Color="#0D9488" />

    <!-- Segmented tab for switching column 2 between the tier list and the tier editor.
         IsChecked is one-way from the view model; clicking runs a command instead of toggling,
         so the two tabs can never both be off (or both on). -->
    <Style x:Key="TierPaneTab" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chip"
                    Background="Transparent"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Tiers/beneficios (col 2) is the widest: defining benefits is the module's main job now,
           redemption is one optional benefit configured inside a tier. -->
      <ColumnDefinition Width="30*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="42*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="28*" />
    </Grid.ColumnDefinitions>

    <!-- ══ COLUMN 1: Program status + Rules ══ -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Estado del programa -->
      <Border Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <!-- Header -->
          <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <materialDesign:PackIcon Kind="StarCircle" Width="18" Height="18"
                                       Foreground="{StaticResource BrushWarning}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="Estado del programa" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Grid.Column="2" Background="{StaticResource BrushSuccessContainer}" CornerRadius="3" Padding="6,2">
                <TextBlock Text="Activo" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
              </Border>
            </Grid>
          </Border>

          <!-- Points display -->
          <Border Background="{StaticResource BrushPrimaryContainer}" CornerRadius="8" Margin="16" Padding="0,20">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding TotalPointsIssued}" Style="{StaticResource TextDisplay}" FontWeight="Black" FontFamily="Consolas"
                         Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" />
              <TextBlock Text="puntos emitidos en total" FontSize="12" Style="{StaticResource MutedText}"
                         HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <!-- KPI strip -->
          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <UniformGrid Columns="3">
              <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <TextBlock Text="{Binding EnrolledCustomers}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="Clientes inscritos" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CheckoutUsageRate}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center" />
                <TextBlock Text="Uso en caja" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <TextBlock Text="{Binding RedemptionsThisMonth}" Style="{StaticResource TextH3}" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource BrushWarning}" HorizontalAlignment="Center" />
                <TextBlock Text="Canjes este mes" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
              </StackPanel>
            </UniformGrid>
          </Border>
          <Button Command="{Binding LoadProgramCommand}" Margin="16,0,16,16" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,4,0" />
              <TextBlock Text="Actualizar datos reales" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Reglas de acumulacion y canje -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Tune" Width="18" Height="18"
                                       Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Reglas de acumulaci&#243;n y canje" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12">
              <TextBlock Text="Puntos por cada $1 vendido" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding PointsPerCurrencyUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.####}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding AccumulationRate}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" />

              <TextBlock Text="Valor en pesos de cada punto" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding RedemptionValuePerPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding RedemptionRate}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" />

              <TextBlock Text="M&#237;nimo de puntos para canjear" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding MinimumRedeemPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

              <TextBlock Text="Descripci&#243;n de la regla" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding RuleDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Margin="0,0,0,12" />

              <TextBlock Text="{Binding CheckoutUsageMode}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
              <TextBlock Text="{Binding ExpirationPolicy}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

              <Button Command="{Binding SaveRulesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Guardar reglas" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12"
                         Foreground="{StaticResource BrushSuccess}"
                         Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}"
                         Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- ══ COLUMN 2: Tiers y beneficios ══ -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="MedalOutline" Width="18" Height="18"
                                       Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Tiers y beneficios" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- The panes swap instead of stacking, so none is squeezed into a sliver. -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ToggleButton Style="{StaticResource TierPaneTab}"
                            IsChecked="{Binding IsTiersListOpen, Mode=OneWay}"
                            Command="{Binding ShowTiersListCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="FormatListBulleted" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="Tiers" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Column="2"
                            Style="{StaticResource TierPaneTab}"
                            IsChecked="{Binding IsTierEditorOpen, Mode=OneWay}"
                            Command="{Binding ShowTierEditorCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="Configuración" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Grid.Column="4"
                            Style="{StaticResource TierPaneTab}"
                            IsChecked="{Binding IsBenefitsOpen, Mode=OneWay}"
                            Command="{Binding ShowBenefitsCommand}"
                            Visibility="{Binding HasBenefitsModule, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="GiftOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="Beneficios" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,12">
          <ListBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier, Mode=TwoWay}" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Visibility="{Binding IsTiersListOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnTierItemMouseLeftButtonUp" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" Style="{StaticResource TextH3}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PointRange}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding BenefitDescription}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ItemsControl ItemsSource="{Binding BenefitLines}" Margin="0,4,0,0"
                                  Visibility="{Binding HasBenefitLines, Converter={StaticResource BoolToVisibilityConverter}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                     Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Top" Margin="0,2,5,0" />
                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RedemptionLabel}" Style="{StaticResource MutedText}" FontSize="11" FontStyle="Italic" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding IsTierEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Nombre del tier" Style="{StaticResource MutedText}" FontSize="11" />
            <TextBox Text="{Binding TierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
            <TextBlock Text="Puntos mínimos" Style="{StaticResource MutedText}" FontSize="11" />
            <TextBox Text="{Binding TierMinimumPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
            <TextBlock Text="Descuento (%)" Style="{StaticResource MutedText}" FontSize="11" />
            <TextBox Text="{Binding TierDiscountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,2" />
            <TextBlock Text="{Binding TierDiscountHint}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="Multiplicador de puntos" Style="{StaticResource MutedText}" FontSize="11" />
            <TextBox Text="{Binding TierPointsMultiplierText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,2" />
            <TextBlock Text="{Binding TierPointsMultiplierHint}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Beneficios del tier (uno por línea)" Style="{StaticResource MutedText}" FontSize="11" />
            <TextBox Text="{Binding TierBenefits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MinHeight="64" MaxHeight="120" Margin="0,3,0,8"
                     ToolTip="Ej: Acceso a capacitaciones&#x0a;Envío gratis" />
            <CheckBox IsChecked="{Binding TierAllowsRedemption, Mode=TwoWay}" Margin="0,0,0,8"
                      Content="Permitir canje de puntos en caja"
                      ToolTip="Si está desactivado, los clientes de este tier no verán la opción de canjear puntos al facturar." />
             <TextBlock Text="Color del tier" Style="{StaticResource MutedText}" FontSize="11" />
            <Grid Margin="0,3,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="28" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TierColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Border Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                      Background="{Binding TierColorPreviewBrush}" Cursor="Hand" MouseLeftButtonDown="OnColorPreviewMouseLeftButtonDown"
                       ToolTip="Presiona para seleccionar color" />
             </Grid>
             <TextBlock Text="Color del texto" Style="{StaticResource MutedText}" FontSize="11" />
             <ComboBox ItemsSource="{Binding TierTextForegroundOptions}" SelectedItem="{Binding TierTextForeground, Mode=TwoWay}" Margin="0,3,0,8" />
             <Border Background="{Binding TierColorPreviewBrush}" Padding="8" CornerRadius="4" Margin="0,0,0,8">
               <TextBlock Text="Vista previa del tier" Foreground="{Binding TierTextForegroundPreviewBrush}" HorizontalAlignment="Center" />
             </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Command="{Binding NewTierCommand}" Margin="0,0,8,0">Nuevo</Button>
              <Button Command="{Binding DeleteTierCommand}" Margin="0,0,8,0">Eliminar</Button>
              <Button Command="{Binding SaveTierCommand}" Style="{StaticResource PrimaryButton}">Guardar tier</Button>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>

          <!-- Benefit catalogue. Visibility is bound on the outer grid because the inner one swaps
               DataContext to the child view model. -->
          <Grid Visibility="{Binding IsBenefitsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid DataContext="{Binding BenefitsViewModel}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ListBox ItemsSource="{Binding Benefits}" SelectedItem="{Binding SelectedBenefit, Mode=TwoWay}"
                       BorderThickness="0" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                    Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1"
                                    VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Inactivo" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                     Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PointsCostLabel}" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                          Visibility="{Binding HasBenefits, Converter={StaticResource BooleanNegationToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="GiftOutline" Width="36" Height="36" HorizontalAlignment="Center"
                                         Foreground="{StaticResource BrushBorder}" />
                <TextBlock Text="Aún no hay beneficios en el catálogo" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="Define un premio y cuántos puntos cuesta. Los clientes lo canjean desde Clientes."
                           Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="240" Margin="0,4,0,0" />
              </StackPanel>

              <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="Nombre del beneficio" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6"
                           materialDesign:HintAssist.Hint="Ej: Asesoría personalizada" />
                  <TextBlock Text="Descripción (opcional)" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                           MinHeight="40" MaxHeight="72" Margin="0,3,0,6" />
                  <TextBlock Text="Costo en puntos" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBox Text="{Binding PointsCostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6"
                           materialDesign:HintAssist.Hint="Ej: 1.000" />
                  <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,0,0,8"
                            Content="Disponible para canje"
                            ToolTip="Si está desactivado, el beneficio deja de ofrecerse pero se conserva en el historial de quienes ya lo canjearon." />
                  <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                             Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding NewCommand}" Margin="0,0,8,0">Nuevo</Button>
                    <Button Command="{Binding DeleteCommand}" Margin="0,0,8,0">Eliminar</Button>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">Guardar beneficio</Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- Empty state: the editor pane is what opens when there is nothing to list. -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsTiersListOpen}" Value="True" />
                      <Condition Binding="{Binding HasTiers}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="MedalOutline" Width="36" Height="36" HorizontalAlignment="Center"
                                     Foreground="{StaticResource BrushBorder}" />
            <TextBlock Text="Aún no hay tiers creados" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <Button Command="{Binding ShowTierEditorCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0">Crear el primero</Button>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
          <Button Command="{Binding LoadTiersCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="Actualizar tiers" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <!-- ══ COLUMN 3: Historial real de puntos ══ -->
    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                     Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Historial real de puntos" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ProgramTransactions}" Margin="16,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,0,0,10" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="16">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="earn">
                              <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <materialDesign:PackIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                          <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="ChartBox" />
                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Kind}" Value="earn">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </materialDesign:PackIcon.Style>
                      </materialDesign:PackIcon>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource TextBody}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding Reason, StringFormat=Motivo: {0}}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Visibility="{Binding Reason, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="earn">
                              <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceContainer}" Margin="16" Padding="12" CornerRadius="6">
          <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap">
            <Run Text="La operaci&#243;n diaria de puntos vive en " />
            <Run Text="Clientes" FontWeight="Bold" />
            <Run Text=" y " />
            <Run Text="Caja" FontWeight="Bold" />
            <Run Text=". Este m&#243;dulo solo configura reglas, tiers y seguimiento del programa." />
          </TextBlock>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
