<UserControl x:Class="POS.Presentation.Views.LoyaltyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Puntos de Lealtad" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Consultar Saldo" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Text="Cliente" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding DataContext.Customers.SearchResults, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                    DisplayMemberPath="FullName"
                    Tag="Selecciona un cliente"
                    Margin="0,0,0,8" />
          <Button Content="Cargar" Command="{Binding LoadBalanceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
          <Border Background="#EFF6FF" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Saldo de Puntos" Foreground="#1D4ED8" />
              <TextBlock Text="{Binding Balance}" Foreground="#1E3A8A" FontSize="32" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <TextBlock Text="Redimir Puntos" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBox Text="{Binding PointsToRedeem, UpdateSourceTrigger=PropertyChanged}" Tag="Puntos a redimir" Margin="0,0,0,8" />
          <Button Content="Aplicar Descuento" Command="{Binding RedeemCommand}" Style="{StaticResource PrimaryButton}" />
          <TextBlock Text="Cargando..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Historial de Transacciones" FontWeight="SemiBold" Margin="0,0,0,12" />
          <DataGrid ItemsSource="{Binding Transactions}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    MaxHeight="500">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
              <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="80" />
              <DataGridTextColumn Header="Puntos" Binding="{Binding Points}" Width="80" />
              <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
