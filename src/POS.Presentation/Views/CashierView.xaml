<UserControl x:Class="POS.Presentation.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
  <UserControl.Resources>
    <Style x:Key="CashSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushText}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CashHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="SecondaryOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
    </Style>

    <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Background" Value="#F4F4F5" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DangerKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
    </Style>

    <Style x:Key="ActionKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CashIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="SearchTextBox"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Tag="Escanea código o escribe el nombre del producto..."
                   FontSize="15"
                   Height="44"
                   KeyDown="SearchTextBox_OnKeyDown"
                   BorderBrush="{StaticResource BrushPrimary}"
                   BorderThickness="2" />

          <xctk:IntegerUpDown Grid.Column="1"
                              Value="{Binding Quantity, Mode=TwoWay}"
                              Minimum="1"
                              Margin="8,0,0,0"
                              Height="44"
                              HorizontalContentAlignment="Center"
                              FontSize="15" />

          <Button Grid.Column="2"
                  Content="Buscar"
                  Command="{Binding SearchCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Height="44"
                  Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <Grid Margin="2,0,0,6"
                  Visibility="{Binding SearchResults.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Sugerencias encontradas"
                         Style="{StaticResource CashHint}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrushPrimary}" />
              <TextBlock Grid.Column="1"
                         Text="↑↓ elegir · Enter agregar"
                         Style="{StaticResource CashHint}" />
            </Grid>

            <Border BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource BrushSurface}"
                    Visibility="{Binding SearchResults.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
              <ListBox x:Name="ResultsListBox"
                       ItemsSource="{Binding SearchResults}"
                       SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                       MouseDoubleClick="ResultsListBox_OnMouseDoubleClick"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Width="32"
                              Height="32"
                              CornerRadius="4"
                              Background="{StaticResource BrushPrimaryContainer}"
                              Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="Pill" Width="16" Height="16" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CashHint}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="COD: {0} · {1}">
                              <Binding Path="Barcode" />
                              <Binding Path="StockText" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>

                      <Border Grid.Column="2"
                              CornerRadius="3"
                              Padding="6,2"
                              VerticalAlignment="Center"
                              Margin="16,0,12,0">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                                <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                                <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StockStatusLabel}"
                                   FontSize="11"
                                   FontWeight="Medium">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                                  <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                                  <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding UnitPriceText}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushPrimary}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <TextBlock Text="Sin coincidencias"
                     Style="{StaticResource CashHint}"
                     Margin="2,6,0,0"
                     Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibilityConverter}}" />
          </StackPanel>

          <Button Grid.Column="1"
                  Content="Agregar"
                  Command="{Binding AddSelectedProductCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="12,0,0,0"
                  VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="2"
                Background="#E8EAED"
                CornerRadius="4"
                Padding="16,10"
                Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Producto" Style="{StaticResource CashHint}" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Cant." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Precio Unit." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <ScrollViewer Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding CartItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1"
                          Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ProductCode, StringFormat=COD: {0}}" Style="{StaticResource CashHint}" />
                        </StackPanel>

                      <xctk:DecimalUpDown Grid.Column="1"
                                          Value="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="1"
                                          Width="56"
                                          Height="28"
                                          Increment="1"
                                          FormatString="N0"
                                          HorizontalContentAlignment="Center"
                                          HorizontalAlignment="Center" />

                      <TextBlock Grid.Column="2"
                                 Text="{Binding UnitPriceText}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                      <TextBlock Grid.Column="3"
                                 Text="{Binding SubtotalText}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                      <StackPanel Grid.Column="4"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <Button Style="{StaticResource CashIconButton}"
                                Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Foreground="{StaticResource BrushDanger}"
                                ToolTip="Eliminar producto">
                          <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Visibility="{Binding HasCartItems, Converter={StaticResource BooleanNegationToVisibilityConverter}}"
                  Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="24" Background="#F4F4F5" HorizontalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No hay productos aún"
                         Style="{StaticResource CashSectionTitle}"
                         HorizontalAlignment="Center"
                         Margin="0,12,0,0" />
              <TextBlock Text="Agrega un producto para comenzar a vender."
                         Style="{StaticResource MutedText}"
                         TextAlignment="Center"
                         MaxWidth="280"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Content="Limpiar carrito"
                  Command="{Binding ClearCartCommand}"
                  Style="{StaticResource GhostButton}" />

          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding CartSummaryText}" Style="{StaticResource CashHint}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SubtotalSummaryText}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <Border Background="#CCFBF1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="TOTAL A PAGAR" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushAccent}" />
            <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Método de pago" Style="{StaticResource CashHint}" FontWeight="Medium" />
        <ComboBox ItemsSource="{Binding PaymentMethods}"
                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                  Margin="0,4,0,12">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Monto recibido" Style="{StaticResource CashHint}" FontWeight="Medium" />
        <xctk:DecimalUpDown Value="{Binding ReceivedAmount, Mode=TwoWay}"
                            Minimum="0"
                            Margin="0,4,0,12"
                            Height="36"
                            FontSize="15"
                            FormatString="N0" />

        <Grid Margin="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="7" />
          <Button Grid.Row="0" Grid.Column="2" Content="8" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="8" />
          <Button Grid.Row="0" Grid.Column="4" Content="9" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="9" />
          <Button Grid.Row="0" Grid.Column="6" Content="⌫" Style="{StaticResource DangerKeypadButton}" Command="{Binding BackspaceReceivedAmountCommand}" />

          <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="4" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="2" Content="5" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="5" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="4" Content="6" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="6" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="6" Content="000" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="000" Margin="0,4,0,0" />

          <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="1" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="2" Content="2" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="2" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="4" Content="3" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="3" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="6" Content="." Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="." Margin="0,4,0,0" />

          <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Content="0" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="0" Margin="0,4,0,0" />
          <Button Grid.Row="3" Grid.Column="6" Content="OK" Style="{StaticResource ActionKeypadButton}" Command="{Binding SetExactAmountCommand}" Margin="0,4,0,0" />
        </Grid>

        <Border CornerRadius="6"
                Padding="12"
                Margin="0,0,0,14">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                  <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PaymentBalanceLabel}" FontSize="13" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding PaymentBalanceText}" FontSize="18" FontWeight="Bold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <Button Content="F5 · Finalizar venta"
                Command="{Binding ConfirmPrototypeSaleCommand}"
                Style="{StaticResource AccentButton}"
                Height="44"
                FontSize="15" />

        <Border Background="{StaticResource BrushPrimaryContainer}"
                BorderBrush="{StaticResource BrushPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,10,0,0"
                Visibility="{Binding IsAwaitingPrintChoice, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="¿Imprimir recibo en la impresora térmica?"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="Sí, imprimir" Command="{Binding PrintReceiptYesCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Grid.Column="2" Content="No" Command="{Binding PrintReceiptNoCommand}" Style="{StaticResource GhostButton}" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
          <Button Content="F6 · Cliente"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding AssociateCustomerCommand}" />
          <Button Content="F7 · En espera"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding HoldSaleCommand}" />
        </StackPanel>

        <Border Background="#F4F4F5"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
