<UserControl x:Class="POS.Presentation.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
  <UserControl.Resources>
    <Style x:Key="CashSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushText}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CashHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="SecondaryOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
    </Style>

    <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Background" Value="#F4F4F5" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DangerKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
    </Style>

    <Style x:Key="ActionKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Tag="Escanear código o escribir nombre..."
                   FontSize="15"
                   Height="44"
                   BorderBrush="{StaticResource BrushPrimary}"
                   BorderThickness="2" />

          <xctk:IntegerUpDown Grid.Column="1"
                              Value="{Binding Quantity, Mode=TwoWay}"
                              Minimum="1"
                              Margin="8,0,0,0"
                              Height="44"
                              HorizontalContentAlignment="Center"
                              FontSize="15" />

          <Button Grid.Column="2"
                  Content="Buscar"
                  Command="{Binding SearchCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Height="44"
                  Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="0,0,6,6"
                  Background="{StaticResource BrushSurface}"
                  Visibility="{Binding SearchResults.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Width="32"
                              Height="32"
                              CornerRadius="4"
                              Background="#E0F2FE"
                              Margin="0,0,12,0" />

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Barcode, StringFormat=COD: {0}}" Style="{StaticResource CashHint}" />
                      </StackPanel>

                      <TextBlock Grid.Column="2"
                                 Text="{Binding UnitPrice, StringFormat=$ {0:N0}}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushPrimary}"
                                 VerticalAlignment="Center"
                                 Margin="16,0,12,0" />

                      <Border Grid.Column="3"
                              Background="#DCFCE7"
                              CornerRadius="3"
                              Padding="6,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding AvailableStock, StringFormat=Stock: {0}}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#16A34A" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Button Grid.Column="1"
                  Content="Agregar"
                  Command="{Binding AddSelectedProductCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="12,0,0,0"
                  VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="2"
                Background="#E8EAED"
                CornerRadius="4"
                Padding="16,10"
                Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Producto" Style="{StaticResource CashHint}" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Cant." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Precio Unit." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <ScrollViewer Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding CartItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1"
                          Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center" />

                      <Border Grid.Column="1"
                              Width="48"
                              Height="28"
                              HorizontalAlignment="Center"
                              BorderBrush="{StaticResource BrushBorder}"
                              BorderThickness="1"
                              CornerRadius="4">
                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      </Border>

                      <TextBlock Grid.Column="2"
                                 Text="{Binding UnitPriceText}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                      <TextBlock Grid.Column="3"
                                 Text="{Binding SubtotalText}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                      <TextBlock Grid.Column="4"
                                 Text="✎  ⌫"
                                 Foreground="{StaticResource BrushMuted}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Visibility="{Binding HasCartItems, Converter={StaticResource BooleanNegationToVisibilityConverter}}"
                  Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="24" Background="#F4F4F5" HorizontalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No hay productos aún"
                         Style="{StaticResource CashSectionTitle}"
                         HorizontalAlignment="Center"
                         Margin="0,12,0,0" />
              <TextBlock Text="Agrega un producto para comenzar a vender."
                         Style="{StaticResource MutedText}"
                         TextAlignment="Center"
                         MaxWidth="280"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Content="Limpiar carrito"
                  Command="{Binding ClearCartCommand}"
                  Style="{StaticResource GhostButton}" />

          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding CartSummaryText}" Style="{StaticResource CashHint}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SubtotalSummaryText}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <Border Background="#CCFBF1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="TOTAL A PAGAR" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushAccent}" />
            <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Método de pago" Style="{StaticResource CashHint}" FontWeight="Medium" />
        <ComboBox ItemsSource="{Binding PaymentMethods}"
                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                  Margin="0,4,0,12">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Monto recibido" Style="{StaticResource CashHint}" FontWeight="Medium" />
        <xctk:DecimalUpDown Value="{Binding ReceivedAmount, Mode=TwoWay}"
                            Minimum="0"
                            Margin="0,4,0,12"
                            Height="36"
                            FontSize="15"
                            FormatString="N0" />

        <Grid Margin="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="7" />
          <Button Grid.Row="0" Grid.Column="2" Content="8" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="8" />
          <Button Grid.Row="0" Grid.Column="4" Content="9" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="9" />
          <Button Grid.Row="0" Grid.Column="6" Content="⌫" Style="{StaticResource DangerKeypadButton}" Command="{Binding BackspaceReceivedAmountCommand}" />

          <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="4" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="2" Content="5" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="5" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="4" Content="6" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="6" Margin="0,4,0,0" />
          <Button Grid.Row="1" Grid.Column="6" Content="000" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="000" Margin="0,4,0,0" />

          <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="1" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="2" Content="2" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="2" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="4" Content="3" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="3" Margin="0,4,0,0" />
          <Button Grid.Row="2" Grid.Column="6" Content="." Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="." Margin="0,4,0,0" />

          <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Content="0" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="0" Margin="0,4,0,0" />
          <Button Grid.Row="3" Grid.Column="6" Content="OK" Style="{StaticResource ActionKeypadButton}" Command="{Binding SetExactAmountCommand}" Margin="0,4,0,0" />
        </Grid>

        <Border Background="#DCFCE7"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cambio" FontSize="13" Foreground="#16A34A" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ChangeText}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
          </Grid>
        </Border>

        <Button Content="F5 · Finalizar venta"
                Command="{Binding ConfirmPrototypeSaleCommand}"
                Style="{StaticResource AccentButton}"
                Height="44"
                FontSize="15" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
          <Button Content="F6 · Cliente" Style="{StaticResource GhostButton}" IsEnabled="False" />
          <Button Content="F7 · En espera" Style="{StaticResource GhostButton}" IsEnabled="False" />
        </StackPanel>

        <Border Background="#F4F4F5"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
