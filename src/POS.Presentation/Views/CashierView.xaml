<UserControl x:Class="POS.Presentation.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Loaded="CashierView_OnLoaded"
             PreviewKeyDown="CashierView_OnPreviewKeyDown"
             Focusable="True">
  <UserControl.Resources>
    <Style x:Key="CashSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushText}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CashHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="SecondaryOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
    </Style>

    <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Background" Value="#F4F4F5" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DangerKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
    </Style>

    <Style x:Key="ActionKeypadButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
      <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CashIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="SearchTextBox"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Tag="Escanea código o escribe el nombre del producto..."
                   FontSize="15"
                   Height="44"
                   KeyDown="SearchTextBox_OnKeyDown"
                   TextChanged="SearchTextBox_OnTextChanged"
                   BorderBrush="{StaticResource BrushPrimary}"
                   BorderThickness="2" />

          <xctk:IntegerUpDown Grid.Column="1"
                              Value="{Binding Quantity, Mode=TwoWay}"
                              Minimum="1"
                              Margin="8,0,0,0"
                              Height="44"
                              HorizontalContentAlignment="Center"
                              FontSize="15" />

          <Button Grid.Column="2"
                  Content="Buscar"
                  Command="{Binding SearchCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Height="44"
                  Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <Grid Margin="2,0,0,6"
                  Visibility="{Binding SearchResults.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Sugerencias encontradas"
                         Style="{StaticResource CashHint}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrushPrimary}" />
              <TextBlock Grid.Column="1"
                         Text="↑↓ elegir · Enter agregar"
                         Style="{StaticResource CashHint}" />
            </Grid>

            <Border BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource BrushSurface}"
                    Visibility="{Binding SearchResults.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
              <ListBox x:Name="ResultsListBox"
                       ItemsSource="{Binding SearchResults}"
                       SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                       MouseDoubleClick="ResultsListBox_OnMouseDoubleClick"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Width="32"
                              Height="32"
                              CornerRadius="4"
                              Background="{StaticResource BrushPrimaryContainer}"
                              Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="Pill" Width="16" Height="16" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CashHint}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="COD: {0} · {1}">
                              <Binding Path="Barcode" />
                              <Binding Path="StockText" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>

                      <Border Grid.Column="2"
                              CornerRadius="3"
                              Padding="6,2"
                              VerticalAlignment="Center"
                              Margin="16,0,12,0">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                                <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                                <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StockStatusLabel}"
                                   FontSize="11"
                                   FontWeight="Medium">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                                  <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                                  <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding UnitPriceText}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushPrimary}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <TextBlock Text="Sin coincidencias"
                     Style="{StaticResource CashHint}"
                     Margin="2,6,0,0"
                     Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibilityConverter}}" />

           <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
             <TextBlock Text="Presentación:" Style="{StaticResource CashHint}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <RadioButton Content="Unidad"
                           IsChecked="{Binding IsUnitPresentationSelected, Mode=OneWay}"
                           Command="{Binding SelectUnitPresentationCommand}"
                           VerticalAlignment="Center" />
              <RadioButton Command="{Binding SelectBoxPresentationCommand}"
                           IsChecked="{Binding IsBoxPresentationSelected, Mode=OneWay}"
                           IsEnabled="{Binding CanSellSelectedAsBox}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="Caja" />
                 <TextBlock Text="{Binding SelectedBoxLabel}" Style="{StaticResource CashHint}" Margin="4,0,0,0" />
               </StackPanel>
             </RadioButton>
              <RadioButton Command="{Binding SelectHalfBoxPresentationCommand}"
                           IsChecked="{Binding IsHalfBoxPresentationSelected, Mode=OneWay}"
                           IsEnabled="{Binding CanSellSelectedAsHalfBox}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="Media caja" />
                 <TextBlock Text="{Binding SelectedHalfBoxLabel}" Style="{StaticResource CashHint}" Margin="4,0,0,0" />
               </StackPanel>
             </RadioButton>
              <RadioButton Command="{Binding SelectQuarterBoxPresentationCommand}"
                           IsChecked="{Binding IsQuarterBoxPresentationSelected, Mode=OneWay}"
                           IsEnabled="{Binding CanSellSelectedAsQuarterBox}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="Cuarto de caja" />
                 <TextBlock Text="{Binding SelectedQuarterBoxLabel}" Style="{StaticResource CashHint}" Margin="4,0,0,0" />
               </StackPanel>
             </RadioButton>
           </StackPanel>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="Agregar"
                  Command="{Binding AddSelectedProductCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="12,0,0,0"
                  VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource BrushSurfaceAlt}"
                CornerRadius="4"
                Padding="16,10"
                Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="100" />
             <ColumnDefinition Width="82" />
             <ColumnDefinition Width="110" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Producto" Style="{StaticResource CashHint}" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Cant." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
             <TextBlock Grid.Column="2" Text="Precio Unit." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Dto. %" ToolTip="Descuento manual por línea. El máximo lo define Administración y se valida al confirmar." Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
             <TextBlock Grid.Column="4" Text="Subtotal" Style="{StaticResource CashHint}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <ScrollViewer Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox x:Name="CartListBox"
                     ItemsSource="{Binding CartItems}"
                     SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#F3F4F6" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2,0,0,0" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#F9FAFB" />
                          </Trigger>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsSelected" Value="True" />
                              <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="#E5E7EB" />
                          </MultiTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.InputBindings>
                <KeyBinding Key="Delete"
                            Command="{Binding RemoveCartItemCommand}"
                            CommandParameter="{Binding SelectedCartItem}" />
              </ListBox.InputBindings>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="0,0,0,1"
                          Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                       <ColumnDefinition Width="82" />
                       <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>

                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                         <TextBlock Style="{StaticResource CashHint}">
                           <TextBlock.Text>
                             <MultiBinding StringFormat="COD: {0} · {1}">
                               <Binding Path="ProductCode" />
                               <Binding Path="PresentationLabel" />
                             </MultiBinding>
                           </TextBlock.Text>
                         </TextBlock>
                      </StackPanel>

                      <xctk:DecimalUpDown Grid.Column="1"
                                          Value="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="1"
                                          Width="56"
                                          Height="28"
                                          Increment="1"
                                          FormatString="N0"
                                          HorizontalContentAlignment="Center"
                                          HorizontalAlignment="Center" />

                       <TextBlock Grid.Column="2"
                                  Text="{Binding UnitPriceText}"
                                 HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />

                       <TextBox Grid.Column="3"
                                Text="{Binding Discount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}"
                                Width="58"
                                HorizontalAlignment="Right"
                                VerticalContentAlignment="Center"
                                IsReadOnly="{Binding DataContext.IsResumedSale, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Descuento manual por línea (%)" />

                       <TextBlock Grid.Column="4"
                                  Text="{Binding SubtotalText}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />

                       <StackPanel Grid.Column="5"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <Button Style="{StaticResource CashIconButton}"
                                Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Foreground="{StaticResource BrushDanger}"
                                ToolTip="Eliminar producto">
                          <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" />
                        </Button>
                      </StackPanel>
                    </Grid>
           </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <Border Visibility="{Binding HasCartItems, Converter={StaticResource BooleanNegationToVisibilityConverter}}"
                  Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource BrushSurfaceContainer}" HorizontalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No hay productos aún"
                         Style="{StaticResource CashSectionTitle}"
                         HorizontalAlignment="Center"
                         Margin="0,12,0,0" />
              <TextBlock Text="Agrega un producto para comenzar a vender."
                         Style="{StaticResource MutedText}"
                         TextAlignment="Center"
                         MaxWidth="280"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Content="Limpiar carrito"
                  Command="{Binding ClearCartCommand}"
                  Style="{StaticResource GhostButton}" />

          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding CartSummaryText}" Style="{StaticResource CashHint}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SubtotalSummaryText}" Style="{StaticResource TextBody}" FontWeight="Medium" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
           <Border Background="{StaticResource BrushSecondaryContainer}"
                  CornerRadius="6"
                  Padding="14"
                  Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="TOTAL A PAGAR" Style="{StaticResource TextCaption}" FontWeight="Medium" Foreground="{StaticResource BrushAccent}" />
              <TextBlock Text="{Binding TotalText}"
                         Style="{StaticResource CashHint}"
                         TextDecorations="Strikethrough"
                         Margin="0,2,0,0"
                         Visibility="{Binding HasLoyaltyDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
              <TextBlock Text="{Binding NetPayableText}" Style="{StaticResource TextDisplay}" FontWeight="Bold" Margin="0,2,0,0" />
            </StackPanel>
           </Border>

          <Border BorderBrush="{StaticResource BrushPrimary}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,0,0,12"
                  Visibility="{Binding HeldSales.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Ventas en espera" Style="{StaticResource CashHint}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
              <ListBox ItemsSource="{Binding HeldSales}" BorderThickness="0" MaxHeight="150" Margin="0,6,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CashHint}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:C0} · {1} línea(s)">
                              <Binding Path="Total" />
                              <Binding Path="Items.Count" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1"
                               Content="Retomar"
                               Style="{StaticResource GhostButton}"
                               Command="{Binding DataContext.ResumeHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Padding="6,4" />
                      <Button Grid.Column="2"
                               Content="Cancelar"
                               Style="{StaticResource GhostButton}"
                               Command="{Binding DataContext.CancelHeldSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Padding="6,4" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSurfaceContainer}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Cliente para puntos" Style="{StaticResource CashHint}" FontWeight="Medium" />
                  <TextBlock Text="{Binding AssignedCustomerLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding CustomerLoyaltyInfo}"
                             Style="{StaticResource CashHint}"
                             Foreground="{StaticResource BrushPrimary}"
                             FontWeight="Medium"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"
                             Visibility="{Binding HasCustomerLoyaltyInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                  <TextBlock Text="Antes de facturar puedes asignar cliente o continuar sin cliente."
                             Style="{StaticResource CashHint}"
                             TextWrapping="Wrap"
                             Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Asignar"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding AssociateCustomerCommand}" />
              </Grid>

              <Border Background="White"
                      BorderBrush="{StaticResource BrushPrimary}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10"
                      Margin="0,10,0,0"
                      Visibility="{Binding IsCustomerAssignmentOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Asignar cliente a la factura" FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="Cerrar"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CloseCustomerAssignmentCommand}"
                            Padding="4,2" />
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomerSearchTextBox"
                             Text="{Binding CustomerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Nombre, cédula o teléfono..."
                             Height="34"
                             KeyDown="CustomerSearchTextBox_OnKeyDown" />
                    <Button Grid.Column="1"
                            Content="Buscar"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCustomerCommand}"
                            Margin="8,0,0,0"
                            Padding="10,4" />
                  </Grid>

                  <ListBox x:Name="CustomerResultsListBox"
                           ItemsSource="{Binding CustomerSearchResults}"
                           SelectedItem="{Binding SelectedCustomerSearchResult, Mode=TwoWay}"
                           MaxHeight="160"
                           Margin="0,8,0,0"
                           BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="CustomerResultItem_OnClick" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                          <StackPanel>
                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CashHint}">
                              <TextBlock.Text>
                                <MultiBinding StringFormat="ID {0} · {1}">
                                  <Binding Path="Identification" />
                                  <Binding Path="Phone" TargetNullValue="sin teléfono" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Sin cliente"
                            Command="{Binding ContinueWithoutCustomerCommand}"
                            Style="{StaticResource GhostButton}" />
                    <Button Grid.Column="2"
                            Content="Quitar cliente"
                            Command="{Binding ClearCustomerCommand}"
                            Style="{StaticResource GhostButton}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSurfaceContainer}"
                  Visibility="{Binding HasLoyaltyPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <!-- Tier benefits lead: redemption is one optional benefit, not the headline. -->
              <StackPanel Visibility="{Binding HasCurrentTier, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Beneficios del cliente" Style="{StaticResource CashHint}" FontWeight="Medium" />
                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TierBenefitText}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding TierDiscountText}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrushPrimary}"
                             Visibility="{Binding HasTierDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TierBenefitLines}" Margin="0,4,0,0"
                              Visibility="{Binding HasTierBenefitLines, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StringFormat='· {0}'}" Style="{StaticResource CashHint}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Redemption: only rendered when the customer's tier opts into it. -->
              <StackPanel Margin="0,10,0,0"
                          Visibility="{Binding HasCustomerLoyaltyInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Canjear puntos" Style="{StaticResource CashHint}" FontWeight="Medium" />
                <TextBlock Text="{Binding CustomerLoyaltyInfo}"
                           Style="{StaticResource CashHint}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding LoyaltyPointsToRedeem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Puntos a canjear..."
                           Height="34"
                           VerticalContentAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="Canjear"
                          Style="{StaticResource PrimaryButton}"
                          Command="{Binding ApplyRedemptionCommand}"
                          Margin="8,0,0,0"
                          Padding="10,4" />
                  <Button Grid.Column="2"
                          Content="Cancelar"
                          Style="{StaticResource GhostButton}"
                          Command="{Binding CancelRedemptionCommand}"
                          Margin="8,0,0,0"
                          Padding="10,4" />
                </Grid>
                <Grid Margin="0,8,0,0"
                      Visibility="{Binding HasLoyaltyDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Descuento por puntos" FontWeight="Medium" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding LoyaltyDiscountText}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrushPrimary}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource BrushPrimaryContainer}"
                  BorderBrush="{StaticResource BrushPrimary}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsQuoteLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Cotización cargada" Style="{StaticResource CashHint}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
                <TextBlock Text="{Binding LoadedQuoteBanner}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Quitar"
                      Command="{Binding ClearLoadedQuoteCommand}"
                      Style="{StaticResource GhostButton}"
                      Padding="6,4" />
            </Grid>
          </Border>

          <Border BorderBrush="{StaticResource BrushWarning}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushWarningContainer}"
                  Visibility="{Binding HasCustomerQuotes, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Cotizaciones pendientes" Style="{StaticResource CashHint}" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}" />
              <TextBlock Text="{Binding SelectedCustomerQuoteSummary}" Style="{StaticResource CashHint}" TextWrapping="Wrap" Margin="0,2,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding CustomerQuotes}"
                          SelectedItem="{Binding SelectedCustomerQuote, Mode=TwoWay}"
                          MinWidth="170">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding QuoteNumber}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CashHint}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}Total {0:C0} · vence {1:dd/MM/yyyy}">
                              <Binding Path="Total" />
                              <Binding Path="ExpiresAt" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Content="Cargar"
                        Command="{Binding LoadCustomerQuoteCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Padding="10,4" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Método de pago" Style="{StaticResource CashHint}" FontWeight="Medium" />
           <ComboBox ItemsSource="{Binding PaymentMethods}"
                     SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                     Margin="0,4,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
             </ComboBox.ItemTemplate>
           </ComboBox>

           <StackPanel Visibility="{Binding IsTransferPayment, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,0,0,12">
             <TextBlock Text="Plataforma de transferencia" Style="{StaticResource CashHint}" FontWeight="Medium" />
             <ComboBox ItemsSource="{Binding PaymentPlatformOptions}"
                       SelectedItem="{Binding BankOrPlatform, Mode=TwoWay}"
                       Margin="0,4,0,0"
                       Height="36" />
           </StackPanel>

           <TextBlock Text="Monto recibido" Style="{StaticResource CashHint}" FontWeight="Medium" />
           <Grid Margin="0,4,0,4">
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <xctk:DecimalUpDown Grid.Column="0"
                                 Value="{Binding ReceivedAmount, Mode=TwoWay}"
                                 Minimum="0"
                                 Height="36"
                                 FontSize="15"
                                 FormatString="N0"
                                 PreviewTextInput="ReceivedAmount_PreviewTextInput"
                                 PreviewKeyDown="ReceivedAmount_PreviewKeyDown"
                                 DataObject.Pasting="ReceivedAmount_Pasting"
                                 LostFocus="ReceivedAmount_LostFocus" />
             <Button Grid.Column="1"
                     Content="Agregar pago"
                     Style="{StaticResource SecondaryButton}"
                     Command="{Binding AddTenderCommand}"
                     Margin="8,0,0,0"
                     Padding="16,0"
                     Height="36"
                     FontWeight="Medium"
                     ToolTip="Registra este método y monto como uno de varios pagos de la venta." />
           </Grid>

           <ItemsControl ItemsSource="{Binding Tenders}"
                         Visibility="{Binding HasTenders, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,0,0,4">
             <ItemsControl.ItemTemplate>
               <DataTemplate>
                 <Grid Margin="0,2,0,2">
                   <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="Auto" />
                     <ColumnDefinition Width="Auto" />
                   </Grid.ColumnDefinitions>
                   <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center" />
                   <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                   <Button Grid.Column="2"
                           Content="✕"
                           Style="{StaticResource GhostButton}"
                           Padding="6,2"
                           Margin="8,0,0,0"
                           Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}" />
                 </Grid>
               </DataTemplate>
             </ItemsControl.ItemTemplate>
           </ItemsControl>

           <TextBlock Text="{Binding RemainingToPayText, StringFormat='Falta por pagar: {0}'}"
                      Style="{StaticResource CashHint}"
                      FontWeight="Medium"
                      Margin="0,0,0,12"
                      Visibility="{Binding HasTenders, Converter={StaticResource BoolToVisibilityConverter}}" />

           <StackPanel Margin="0,0,0,12"
                       Visibility="{Binding IsDeferredAmountVisible, Converter={StaticResource BoolToVisibilityConverter}}">
             <TextBlock Text="Saldo diferido" Style="{StaticResource CashHint}" FontWeight="Medium" />
             <TextBlock Text="Parte de la venta que queda pendiente para el cliente. Se calcula automáticamente."
                        Style="{StaticResource CashHint}"
                        TextWrapping="Wrap"
                        Margin="0,2,0,4" />
             <xctk:DecimalUpDown Value="{Binding DeferredAmount, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Minimum="0"
                                 Height="36"
                                 FontSize="15"
                                 FormatString="N0" />
           </StackPanel>

          <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="7" />
            <Button Grid.Row="0" Grid.Column="2" Content="8" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="8" />
            <Button Grid.Row="0" Grid.Column="4" Content="9" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="9" />
            <Button Grid.Row="0" Grid.Column="6" Content="⌫" Style="{StaticResource DangerKeypadButton}" Command="{Binding BackspaceReceivedAmountCommand}" />

            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="4" Margin="0,4,0,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="5" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="5" Margin="0,4,0,0" />
            <Button Grid.Row="1" Grid.Column="4" Content="6" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="6" Margin="0,4,0,0" />
            <Button Grid.Row="1" Grid.Column="6" Content="000" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="000" Margin="0,4,0,0" />

            <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="1" Margin="0,4,0,0" />
            <Button Grid.Row="2" Grid.Column="2" Content="2" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="2" Margin="0,4,0,0" />
            <Button Grid.Row="2" Grid.Column="4" Content="3" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="3" Margin="0,4,0,0" />
             <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Content="0" Style="{StaticResource KeypadButton}" Command="{Binding AppendReceivedAmountCommand}" CommandParameter="0" Margin="0,4,0,0" />
            <Button Grid.Row="3" Grid.Column="6" Content="OK" Style="{StaticResource ActionKeypadButton}" Command="{Binding SetExactAmountCommand}" Margin="0,4,0,0" />
          </Grid>

          <Border CornerRadius="6"
                  Padding="12"
                  Margin="0,0,0,14">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding PaymentBalanceLabel}" FontSize="13" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="1" Text="{Binding PaymentBalanceText}" FontSize="18" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPaymentShortfall}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

           <Button Content="F5 · Finalizar venta"
                   Command="{Binding ConfirmSaleCommand}"
                  Style="{StaticResource AccentButton}"
                  Height="44"
                  FontSize="15" />

          <Border BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,10,0,0"
                  Background="{StaticResource BrushSurfaceContainer}">
            <StackPanel>
              <TextBlock Text="Descuento del cajero" Style="{StaticResource CashHint}" FontWeight="Medium" />
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding CartDiscountPercentInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDecimalConverter}}"
                         Tag="% de descuento..."
                         Height="34"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Aplicar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyCartDiscountCommand}"
                        Margin="8,0,0,0"
                        Padding="10,4" />
                <Button Grid.Column="2"
                        Content="Quitar"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ClearCartDiscountCommand}"
                        Margin="8,0,0,0"
                        Padding="10,4" />
              </Grid>
              <Grid Margin="0,8,0,0"
                    Visibility="{Binding HasManualDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Descuento manual" FontWeight="Medium" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ManualDiscountText}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushPrimary}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource BrushDangerSoft}"
                  BorderBrush="{StaticResource BrushDanger}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,10,0,0"
                  Visibility="{Binding IsAwaitingSaleConfirmation, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="¿Deseas confirmar esta compra?"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,4" />
              <TextBlock Text="{Binding NetPayableText, StringFormat='Total a cobrar: {0}'}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Sí, confirmar" Command="{Binding ConfirmSaleYesCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="2" Content="Cancelar" Command="{Binding ConfirmSaleNoCommand}" Style="{StaticResource GhostButton}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource BrushPrimaryContainer}"
                  BorderBrush="{StaticResource BrushPrimary}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,10,0,0"
                  Visibility="{Binding IsAwaitingPrintChoice, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="¿Imprimir recibo en la impresora térmica?"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Sí, imprimir" Command="{Binding PrintReceiptYesCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="2" Content="No" Command="{Binding PrintReceiptNoCommand}" Style="{StaticResource GhostButton}" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0">
            <Button Content="F6 · Cliente"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding AssociateCustomerCommand}" />
            <Button Content="F7 · En espera"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding HoldSaleCommand}" />
          </StackPanel>

          <Border Background="{StaticResource BrushSurfaceContainer}"
                  BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12"
                  Margin="0,12,0,0"
                  Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
