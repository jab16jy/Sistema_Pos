<UserControl x:Class="POS.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:POS.Presentation.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="SettingsView_OnLoaded">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Subtab bar: Centro de control / Negocio / Impresión y envíos -->
    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabOverview" GroupName="ConfigTabs" Style="{StaticResource SubtabItemStyle}" IsChecked="True">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Cog" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="Centro de control" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabBusiness" GroupName="ConfigTabs" Style="{StaticResource SubtabItemStyle}">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Storefront" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="Negocio" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabIntegrations" GroupName="ConfigTabs" Style="{StaticResource SubtabItemStyle}">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Hub" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="Impresión y envíos" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- ════ TAB: Centro de control ════ -->
    <ScrollViewer Grid.Row="1" Visibility="{Binding IsChecked, ElementName=TabOverview, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel Margin="0,0,4,12">

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel Margin="14">
            <TextBlock Text="Módulos administrativos y utilidades" FontSize="16" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="720">
              Desde aquí se agrupan funciones de baja frecuencia para que no compitan con la operación diaria de caja. La navegación principal queda enfocada en vender, cobrar y consultar.
            </TextBlock>
          </StackPanel>
        </Border>

        <UniformGrid Columns="4" Margin="0,0,0,12">
          <controls:KpiCard Label="Usuarios activos" Value="{Binding ActiveUsersSummary}" Hint="Sin consulta agregada en esta fase" Margin="0,0,12,0" />
          <controls:KpiCard Label="Turno actual" Value="{Binding CurrentShiftSummary}" Hint="Sin consulta agregada en esta fase" Margin="0,0,12,0" />
          <controls:KpiCard Label="Último backup" Value="{Binding LastBackupSummary}" Hint="Según carpeta configurada" Margin="0,0,12,0" />
          <controls:KpiCard Label="Canales listos" Value="{Binding ReadyChannelsSummary}" Hint="Impresora, SMTP y WhatsApp" />
        </UniformGrid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.8*" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <materialDesign:PackIcon Kind="Apps" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                  <TextBlock Text="Módulos de gestión" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <UniformGrid Columns="2" Rows="2">
                  <controls:QuickLink TitleText="Productos" Subtitle="Catálogo, precios y variantes." IconKind="PackageVariant" Margin="0,0,8,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[0], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Inventario" Subtitle="Existencias, ajustes y movimientos de stock." IconKind="Warehouse" Margin="0,0,0,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[1], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Compras" Subtitle="Órdenes a proveedores y recepción de mercancía." IconKind="Cart" Margin="0,0,8,0"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[2], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Reportes" Subtitle="Ventas, KPIs y analítica del negocio." IconKind="ChartBox"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[3], RelativeSource={RelativeSource AncestorType=Window}}" />
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <materialDesign:PackIcon Kind="ViewDashboard" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                  <TextBlock Text="Utilidades agrupadas" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <UniformGrid Columns="2" Rows="3">
                  <controls:QuickLink TitleText="Turnos y cierre operativo" Subtitle="Apertura, arqueo y cierre del turno actual." IconKind="ClockOutline" Margin="0,0,8,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[4], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Programa de lealtad" Subtitle="Reglas, tiers, canje y vigencias." IconKind="StarCircle" Margin="0,0,0,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[5], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Etiquetas y códigos" Subtitle="Generación e impresión en lote." IconKind="BarcodeScan" Margin="0,0,8,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubModules[6], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Usuarios y permisos" Subtitle="Alta, baja, roles y bloqueo de acciones sensibles." IconKind="AccountCog" Margin="0,0,0,8"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubExtraModules[0], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <controls:QuickLink TitleText="Auditoría operativa" Subtitle="Consulta cambios, devoluciones y movimientos críticos." IconKind="ClipboardCheck" Margin="0,0,8,0"
                                      Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding DataContext.AdminHubExtraModules[1], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <Border Style="{StaticResource Card}" Background="{StaticResource BrushSurfaceContainer}">
                    <Grid Margin="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <materialDesign:PackIcon Kind="Backup" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Respaldos" FontWeight="SemiBold" />
                        <TextBlock Text="Backup manual, carpeta destino y restauración guiada." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <materialDesign:PackIcon Kind="CogSync" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                  <TextBlock Text="Decisiones de arquitectura visual" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Cierre de caja operativo" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Background="{StaticResource BrushSuccessContainer}" BorderBrush="{StaticResource BrushSuccess}">
                    <TextBlock Text="Solo en Turnos" FontSize="11" />
                  </Border>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Lealtad diaria del cliente" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Background="{StaticResource BrushPrimaryContainer}" BorderBrush="{StaticResource BrushPrimary}">
                    <TextBlock Text="Dentro de Clientes y Caja" FontSize="11" />
                  </Border>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Comunicación digital" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Background="{StaticResource BrushPrimaryContainer}" BorderBrush="{StaticResource BrushPrimary}">
                    <TextBlock Text="Dentro de Facturas y Cotizaciones" FontSize="11" />
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Etiquetas / códigos" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Background="{StaticResource BrushWarningContainer}" BorderBrush="{StaticResource BrushWarning}">
                    <TextBlock Text="Utilidad administrativa" FontSize="11" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <materialDesign:PackIcon Kind="Alert" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
                  <TextBlock Text="Alertas" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="{StaticResource BrushWarningContainer}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                  <TextBlock Foreground="{StaticResource BrushWarning}" FontSize="12" TextWrapping="Wrap">
                    Falta definir una política única para autorizaciones: devoluciones, anulación de documentos y ajustes manuales de stock deberían pedir rol administrador.
                  </TextBlock>
                </Border>
                <Border Background="{StaticResource BrushWarningContainer}" CornerRadius="6" Padding="10">
                  <TextBlock Foreground="{StaticResource BrushWarning}" FontSize="12" TextWrapping="Wrap">
                    WhatsApp debe abrir primero la app de escritorio y, si no está disponible, caer automáticamente a WhatsApp Web sin bloquear la operación.
                  </TextBlock>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                  <TextBlock Text="Checklist de operación segura" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Impresora principal configurada" VerticalAlignment="Center" />
                  <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                        <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPrinterConfigured}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Medium">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Revisar" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrinterConfigured}" Value="True">
                              <Setter Property="Text" Value="OK" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="SMTP del negocio" VerticalAlignment="Center" />
                  <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                        <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSmtpConfigured}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Medium">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Revisar" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSmtpConfigured}" Value="True">
                              <Setter Property="Text" Value="Configurado" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="WhatsApp Desktop / Web" VerticalAlignment="Center" />
                  <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                        <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsWhatsAppReady}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Medium">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Revisar" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWhatsAppReady}" Value="True">
                              <Setter Property="Text" Value="Listo" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Ruta de backup" VerticalAlignment="Center" />
                  <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                        <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBackupConfigured}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Medium">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Sin configurar" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBackupConfigured}" Value="True">
                              <Setter Property="Text" Value="OK" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ════ TAB: Negocio ════ -->
    <ScrollViewer Grid.Row="1" Visibility="{Binding IsChecked, ElementName=TabBusiness, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid Margin="0,0,4,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
          <StackPanel Margin="14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <materialDesign:PackIcon Kind="Storefront" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
              <TextBlock Text="Datos del negocio" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Nombre comercial" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding BusinessName, Mode=TwoWay}" Tag="Esthetic Medical Store" Margin="0,0,0,8" />
            <TextBlock Text="NIT / identificación fiscal" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding TaxId, Mode=TwoWay}" Tag="901.234.567-8" Margin="0,0,0,8" />
            <TextBlock Text="Dirección" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding BusinessAddress, Mode=TwoWay}" Tag="Cra 14 # 85-10 · Bogotá" AcceptsReturn="True" Height="70" Margin="0,0,0,8" />
            <TextBlock Text="Moneda" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding CurrencyCode, Mode=TwoWay}" Tag="COP" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0" />
                  <TextBlock Text="Guardar" />
                </StackPanel>
              </Button>
              <Button Command="{Binding BackupCommand}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Margin="0,0,4,0" />
                  <TextBlock Text="Exportar respaldo" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Margin="14">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="ShieldCheck" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="Políticas comerciales" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="IVA por defecto" /><TextBlock Grid.Column="1" Text="19%" FontWeight="Medium" />
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Ventas a crédito" /><TextBlock Grid.Column="1" Text="Habilitadas" FontWeight="Medium" />
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Devoluciones sin admin" /><TextBlock Grid.Column="1" Text="No permitido" FontWeight="Medium" />
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Backup automático diario" /><TextBlock Grid.Column="1" Text="06:10" FontWeight="Medium" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel Margin="14">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="Uso recomendado" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                Este módulo guarda parámetros globales. No debe contener operación diaria de clientes, facturas o caja. Es backoffice puro.
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ════ TAB: Impresión y envíos ════ -->
    <ScrollViewer Grid.Row="1" Visibility="{Binding IsChecked, ElementName=TabIntegrations, Converter={StaticResource BoolToVisibilityConverter}}">
      <UniformGrid Columns="3" Margin="0,0,4,12">
        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
          <StackPanel Margin="14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <materialDesign:PackIcon Kind="Printer" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
              <TextBlock Text="Impresión" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Impresora" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" IsEditable="True"
                        ItemsSource="{Binding AvailablePrinters}"
                        Text="{Binding PrinterCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="Detectar" Command="{Binding RefreshPrintersCommand}"
                      Margin="6,0,0,0" Padding="8,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Se detecta automáticamente. Elige por nombre; el puerto (USB, red) se resuelve solo."
                       Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Plantilla de recibo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding ReceiptTemplate, Mode=TwoWay}" Margin="0,0,0,8">
              <ComboBoxItem Content="80 mm térmico" IsSelected="True" />
              <ComboBoxItem Content="A4 resumen" />
            </ComboBox>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap">
              La impresión de etiquetas y códigos se gestiona desde la utilidad administrativa, no desde la caja.
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
          <StackPanel Margin="14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <materialDesign:PackIcon Kind="Email" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
              <TextBlock Text="Email / SMTP" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Host" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding SmtpHost, Mode=TwoWay}" Margin="0,0,0,8" />
              <TextBlock Text="Cuenta remitente" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding SmtpSenderAddress, Mode=TwoWay}" Margin="0,0,0,8" />
              <TextBlock Text="Usuario SMTP" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding SmtpUser, Mode=TwoWay}" Margin="0,0,0,8" />
              <TextBlock Text="Contraseña / app password" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <PasswordBox Tag="Usa una app password cuando el proveedor lo exija"
                           PasswordChanged="SmtpPasswordBox_OnPasswordChanged"
                           Margin="0,0,0,8" />
              <TextBlock Text="Puerto" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding SmtpPort, Mode=TwoWay}" Margin="0,0,0,8" />
              <CheckBox Content="Usar SSL / TLS" IsChecked="{Binding SmtpUseSsl, Mode=TwoWay}" Margin="0,0,0,8" />
              <TextBlock Text="Destino de prueba" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding TestEmailRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="destino@email.com" Margin="0,0,0,8" />
             <Grid>
               <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*" />
                 <ColumnDefinition Width="8" />
                 <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                 <StackPanel Orientation="Horizontal">
                   <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0" />
                   <TextBlock Text="Guardar SMTP" />
                 </StackPanel>
               </Button>
               <Button Grid.Column="2" Command="{Binding TestEmailCommand}">
                 <StackPanel Orientation="Horizontal">
                   <materialDesign:PackIcon Kind="Send" Width="16" Height="16" Margin="0,0,4,0" />
                   <TextBlock Text="Enviar prueba" />
                 </StackPanel>
               </Button>
             </Grid>
           </StackPanel>
         </Border>

         <Border Style="{StaticResource Card}">
           <StackPanel Margin="14">
             <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
               <materialDesign:PackIcon Kind="WhatsApp" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
               <TextBlock Text="WhatsApp Desktop / Web" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
             </StackPanel>
             <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8">
               El sistema intentará abrir primero WhatsApp Desktop. Si no está disponible, abrirá WhatsApp Web automáticamente.
             </TextBlock>
             <TextBlock Text="Estado" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
             <TextBox Text="{Binding WhatsAppStatus}" IsReadOnly="True" Margin="0,0,0,8" />
             <TextBlock Text="Número de prueba" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
             <TextBox Text="{Binding TestWhatsAppNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="3001234567" Margin="0,0,0,8" />
             <Button Command="{Binding TestWhatsAppCommand}">
               <StackPanel Orientation="Horizontal">
                 <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Margin="0,0,4,0" />
                 <TextBlock Text="Abrir WhatsApp" />
               </StackPanel>
             </Button>
           </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>
  </Grid>
</UserControl>
