<UserControl x:Class="POS.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Configuración" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Text="Información del negocio" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox Text="{Binding BusinessName, Mode=TwoWay}" Tag="Nombre del negocio" Margin="0,0,0,8" />
            <TextBox Text="{Binding BusinessAddress, Mode=TwoWay}" Tag="Dirección" AcceptsReturn="True" Height="70" Margin="0,0,0,8" />
            <TextBox Text="{Binding TaxId, Mode=TwoWay}" Tag="NIT o identificación fiscal" Margin="0,0,0,8" />
            <TextBlock Text="Impresora" FontWeight="SemiBold" Margin="0,16,0,12" />
            <TextBox Text="{Binding PrinterCommand, Mode=TwoWay}" Tag="Comando o ruta de la impresora" Margin="0,0,0,8" />
            <TextBox Text="{Binding PrinterWorkingDirectory, Mode=TwoWay}" Tag="Directorio de trabajo (opcional)" Margin="0,0,0,8" />
            <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,16,0,12" />
            <TextBox Text="{Binding BackupDirectory, Mode=TwoWay}" Tag="Directorio para backups" Margin="0,0,0,8" />
            <TextBlock Text="Moneda" FontWeight="SemiBold" Margin="0,16,0,12" />
            <TextBox Text="{Binding CurrencyCode, Mode=TwoWay}" Tag="Código de moneda (COP, USD, EUR)" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
              <Button Content="Cargar" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
              <Button Content="Backup ahora" Command="{Binding BackupCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Advertencias" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,0,0,8" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4">
                  <StackPanel>
                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#856404" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No hay advertencias." Style="{StaticResource MutedText}" Visibility="{Binding Warnings.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
