<UserControl x:Class="POS.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Reporte Operacional card -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Reporte Operacional" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Ventas, efectivo esperado, pagos digitales y abonos." Style="{StaticResource MutedText}" />
          <TextBlock Text="Cargando..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource MutedText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
          <!-- Preset range buttons -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Hoy" Command="{Binding SetTodayCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button Content="Esta semana" Command="{Binding SetThisWeekCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button Content="Este mes" Command="{Binding SetThisMonthCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
          <!-- Date pickers -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ReportFromDate}" Width="130" Margin="0,0,8,0" />
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ReportToDate}" Width="130" />
          </StackPanel>
          <!-- Action buttons -->
          <StackPanel Orientation="Horizontal">
            <Button Content="Generar reporte" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button Content="PDF" Command="{Binding ExportOperationalPdfCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button Content="Excel" Command="{Binding ExportOperationalExcelCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Error card -->
    <Border Grid.Row="1" Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
    </Border>

    <!-- Totals summary card -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#EFF6FF" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Total Facturado" Foreground="#1D4ED8" />
              <TextBlock Text="{Binding BilledTotalText}" Foreground="#1E3A8A" FontSize="26" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="12" Padding="14" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Efectivo Esperado en Caja" Foreground="#166534" />
              <TextBlock Text="{Binding ExpectedDrawerCashText}" Foreground="#14532D" FontSize="26" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </Grid>
        <UniformGrid Columns="3" Margin="0,16,0,0">
          <Border Background="#F0FDF4" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Efectivo de Ventas" Foreground="#15803D" />
              <TextBlock Text="{Binding CashCollectedText}" Foreground="#14532D" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#FAF5FF" CornerRadius="12" Padding="14" Margin="8,0,8,0">
            <StackPanel>
              <TextBlock Text="Pagos Digitales" Foreground="#7E22CE" />
              <TextBlock Text="{Binding DigitalCollectedText}" Foreground="#581C87" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#FFF7ED" CornerRadius="12" Padding="14" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Abonos Cobrados" Foreground="#C2410C" />
              <TextBlock Text="{Binding ReceivableSettlementsText}" Foreground="#9A3412" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanNegationToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
      </StackPanel>
    </Border>

    <!-- Analytics / Profit Section -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Analisis de Rentabilidad" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Top productos, comparacion de periodos, plataformas y margenes." Style="{StaticResource MutedText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
            <!-- Analytics date pickers -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding AnalyticsFromDateAsDateTime, Mode=TwoWay}" Width="130" Margin="0,0,8,0" />
              <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding AnalyticsToDateAsDateTime, Mode=TwoWay}" Width="130" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="Cargar Analisis" Command="{Binding LoadAnalyticsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Content="PDF" Command="{Binding ExportProfitPdfCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Content="Excel" Command="{Binding ExportProfitExcelCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Top 10 Productos -->
        <TextBlock Text="Top 10 Productos" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding TopSellers}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MaxHeight="200"
                  Margin="0,0,0,16">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="Unidades" Binding="{Binding UnitsSold}" Width="80" />
            <DataGridTextColumn Header="Ingreso Total" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0}'}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Comparacion de Periodos -->
        <TextBlock Text="Comparacion de Periodos" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Background="#F0FDF4" CornerRadius="12" Padding="14" Margin="0,0,0,16" DataContext="{Binding PeriodComparison}">
          <UniformGrid Columns="4">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Ingreso Actual" Style="{StaticResource MutedText}" FontSize="11" />
              <TextBlock Text="{Binding CurrentRevenue, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Ingreso Anterior" Style="{StaticResource MutedText}" FontSize="11" />
              <TextBlock Text="{Binding PriorRevenue, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Margen Actual" Style="{StaticResource MutedText}" FontSize="11" />
              <TextBlock Text="{Binding CurrentMargin, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Crecimiento %" Style="{StaticResource MutedText}" FontSize="11" />
              <TextBlock Text="{Binding RevenueGrowthPercent, StringFormat='{}{0:N1}%'}" FontWeight="Bold" />
            </StackPanel>
          </UniformGrid>
        </Border>

        <!-- Desglose por Plataforma -->
        <TextBlock Text="Desglose por Plataforma" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding PlatformBreakdown}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MaxHeight="150"
                  Margin="0,0,0,16">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Plataforma" Binding="{Binding Platform}" Width="*" />
            <DataGridTextColumn Header="Monto Total" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="120" />
            <DataGridTextColumn Header="Transacciones" Binding="{Binding TransactionCount}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Margen por Producto -->
        <TextBlock Text="Margen por Producto" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding ProductMargins}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MaxHeight="200">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="Ingreso" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0}'}" Width="100" />
            <DataGridTextColumn Header="Costo" Binding="{Binding TotalCost, StringFormat='{}{0:N0}'}" Width="100" />
            <DataGridTextColumn Header="Margen" Binding="{Binding GrossMargin, StringFormat='{}{0:N0}'}" Width="100" />
            <DataGridTextColumn Header="Margen %" Binding="{Binding MarginPercent, StringFormat='{}{0:N1}%'}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <!-- Cierre de Caja card -->
    <Border Grid.Row="4" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Cierre de Caja" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Ingresa el efectivo contado físicamente para cerrar el turno." Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <!-- Efectivo esperado (read-only) -->
          <Border Background="#EFF6FF" CornerRadius="10" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Efectivo Esperado" Foreground="#1D4ED8" FontSize="13" />
              <TextBlock Text="{Binding ExpectedCashText}" Foreground="#1E3A8A" FontSize="22" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <!-- Efectivo contado (input) -->
          <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="Efectivo Contado" FontSize="13" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <TextBox Text="{Binding CountedCashText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18" FontWeight="Bold" Padding="10,8"
                     HorizontalContentAlignment="Right" />
          </StackPanel>
          <!-- Diferencia -->
          <Border Grid.Column="2" CornerRadius="10" Padding="14" Margin="8,0,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#F0FDF4" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DifferenceIsNegative}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="Diferencia" FontSize="13" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding DifferenceText}" FontSize="22" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#166534" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DifferenceIsNegative}" Value="True">
                        <Setter Property="Foreground" Value="#DC2626" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
        <Button Content="Cerrar Caja" Command="{Binding CloseCashCommand}"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0,16,0,0" />
        <TextBlock Text="{Binding ClosingStatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasClosingStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>
    </Border>

  </Grid>
  </ScrollViewer>
</UserControl>
