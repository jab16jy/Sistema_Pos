<UserControl x:Class="POS.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Reporte Operacional" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Ventas, efectivo esperado, pagos digitales y abonos." Style="{StaticResource MutedText}" />
          <TextBlock Text="Cargando..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource MutedText}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Cargar reporte del día" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#EFF6FF" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Total Facturado" Foreground="#1D4ED8" />
              <TextBlock Text="{Binding BilledTotalText}" Foreground="#1E3A8A" FontSize="26" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="12" Padding="14" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Efectivo Esperado en Caja" Foreground="#166534" />
              <TextBlock Text="{Binding ExpectedDrawerCashText}" Foreground="#14532D" FontSize="26" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </Grid>
        <UniformGrid Columns="3" Margin="0,16,0,0">
          <Border Background="#F0FDF4" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Efectivo de Ventas" Foreground="#15803D" />
              <TextBlock Text="{Binding CashCollectedText}" Foreground="#14532D" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#FAF5FF" CornerRadius="12" Padding="14" Margin="8,0,8,0">
            <StackPanel>
              <TextBlock Text="Pagos Digitales" Foreground="#7E22CE" />
              <TextBlock Text="{Binding DigitalCollectedText}" Foreground="#581C87" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Background="#FFF7ED" CornerRadius="12" Padding="14" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Abonos Cobrados" Foreground="#C2410C" />
              <TextBlock Text="{Binding ReceivableSettlementsText}" Foreground="#9A3412" FontSize="20" FontWeight="Bold" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanNegationToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
