<UserControl x:Class="POS.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ Subtab bar ══
         SubtabBar control has no bindable SelectedItem/content-switching output (same deviation
         documented in Phases 4/6/7/9) — RadioButtons styled with SubtabItemStyle instead. -->
    <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="Resumen operacional" GroupName="ReportSubtabs"
                     IsChecked="{Binding IsOperationalSubtabActive, Mode=TwoWay}"
                     Style="{StaticResource SubtabItemStyle}" />
        <RadioButton Content="Rentabilidad" GroupName="ReportSubtabs"
                     IsChecked="{Binding IsProfitabilitySubtabActive, Mode=TwoWay}"
                     Style="{StaticResource SubtabItemStyle}" />
        <RadioButton Content="Cierres y arqueos" GroupName="ReportSubtabs"
                     IsChecked="{Binding IsClosingsSubtabActive, Mode=TwoWay}"
                     Style="{StaticResource SubtabItemStyle}" />
      </StackPanel>
    </Border>

    <!-- ══ Shared status banner (error / loading) ══
         Hoisted out of the per-subtab sections so it stays visible regardless of which subtab is
         active — LoadReportAsync (Operational), LoadAnalyticsAsync (Rentabilidad), and
         LoadClosingsAsync (Cierres y arqueos) all write to the same HasError/ErrorMessage/IsLoading
         properties, so a single shared banner covers all three load paths without triplicating it. -->
    <StackPanel Grid.Row="1" Margin="20,12,20,0">
      <Border Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="Cargando..." Style="{StaticResource MutedText}" Margin="0,0,0,12"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
    </StackPanel>

    <!-- ══════════════════════ TAB: Resumen operacional ══════════════════════ -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsOperationalSubtabActive, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid Margin="0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter toolbar -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Preset buttons -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Hoy" Command="{Binding SetTodayCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Content="Semana" Command="{Binding SetThisWeekCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Content="Mes" Command="{Binding SetThisMonthCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>

            <!-- Explicit date range -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding ReportFromDate}" Width="130" Margin="0,0,8,0" />
              <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding ReportToDate}" Width="130" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Generar reporte" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Command="{Binding ExportOperationalPdfCommand}" Padding="8,0" Margin="0,0,6,0" ToolTip="Exportar PDF">
                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" />
              </Button>
              <Button Content="Excel" Command="{Binding ExportOperationalExcelCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 5 KPI cards (13.3) -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
          <Border Style="{StaticResource Card}" Margin="0,0,8,0" BorderThickness="0,0,0,3" BorderBrush="{StaticResource BrushPrimary}">
            <StackPanel>
              <TextBlock Text="TOTAL FACTURADO" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding BilledTotalText}" Style="{StaticResource TextH2}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushPrimary}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="8,0,8,0">
            <StackPanel>
              <TextBlock Text="EFECTIVO ESPERADO" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ExpectedDrawerCashText}" Style="{StaticResource TextH2}" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="8,0,8,0">
            <StackPanel>
              <TextBlock Text="EFECTIVO VENTAS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CashCollectedText}" Style="{StaticResource TextH2}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushSuccess}" Margin="0,4,0,4" />
              <Border Style="{StaticResource ChipSuccessStyle}" HorizontalAlignment="Left"
                      Visibility="{Binding IsDrawerCashBalanced, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Cuadra" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="8,0,8,0">
            <StackPanel>
              <TextBlock Text="PAGOS DIGITALES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DigitalCollectedText}" Style="{StaticResource TextH2}" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <!-- Note: the wireframe's 5th KPI is "Transferencias", a payment sub-category that does not
               exist in OperationalReportDto (only cash-vs-digital totals are tracked). Substituted with
               the real, already-tracked "Abonos cobrados" (receivable settlements) metric instead of
               inventing a figure — see apply-progress for details. -->
          <Border Style="{StaticResource Card}" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="ABONOS COBRADOS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ReceivableSettlementsText}" Style="{StaticResource TextH2}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushWarning}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Charts: Ventas por hora (placeholder) + Por método de pago (real) -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <!-- Ventas por hora: known gap — no hourly-bucket query exists in IGetOperationalReportUseCase
               / OperationalReportDto. Adding one requires a new DB-aggregated query (Infrastructure-layer
               change) out of scope for this Presentation-only PR; shown as an illustrative static
               placeholder, consistent with the KPI placeholders used in Phases 6/11. -->
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <TextBlock Text="Ventas por hora" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="16,12,16,4" />
              <TextBlock Text="Datos ilustrativos — pendiente de agregacion por hora en el backend." Style="{StaticResource MutedText}" FontSize="11" Margin="16,0,16,12" />
              <UniformGrid Columns="10" Height="120" Margin="16,0,16,16" VerticalAlignment="Bottom">
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="46" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="74" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="54" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="96" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="66" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimary}" Height="110" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimary}" Height="90" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="106" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="48" Margin="2,0" VerticalAlignment="Bottom" />
                <Border Background="{StaticResource BrushPrimaryContainer}" Height="18" Margin="2,0" VerticalAlignment="Bottom" />
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- Por metodo de pago: real 2-category (cash/digital) split with percentages -->
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Por metodo de pago" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,12" />

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Efectivo" Style="{StaticResource TextSmall}" />
                <TextBlock Grid.Column="1" Style="{StaticResource TextSmall}" FontWeight="Bold" FontFamily="Consolas">
                  <Run Text="{Binding CashCollectedText, Mode=OneWay}" />
                  <Run Text=" (" /><Run Text="{Binding CashPaymentPercentText, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
              </Grid>
              <Border Height="8" Background="{StaticResource BrushSurfaceContainer}" CornerRadius="4" Margin="0,0,0,12">
                <Border Background="{StaticResource BrushSuccess}" CornerRadius="4" HorizontalAlignment="Left"
                        Width="{Binding CashPaymentBarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=220}" />
              </Border>

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Digital (tarjeta + transferencia)" Style="{StaticResource TextSmall}" />
                <TextBlock Grid.Column="1" Style="{StaticResource TextSmall}" FontWeight="Bold" FontFamily="Consolas">
                  <Run Text="{Binding DigitalCollectedText, Mode=OneWay}" />
                  <Run Text=" (" /><Run Text="{Binding DigitalPaymentPercentText, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
              </Grid>
              <Border Height="8" Background="{StaticResource BrushSurfaceContainer}" CornerRadius="4">
                <Border Background="{StaticResource BrushPrimary}" CornerRadius="4" HorizontalAlignment="Left"
                        Width="{Binding DigitalPaymentBarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=220}" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
      </Grid>
    </ScrollViewer>

    <!-- ══════════════════════ TAB: Rentabilidad ══════════════════════ -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsProfitabilitySubtabActive, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid Margin="0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Analisis de rentabilidad" Style="{StaticResource TextH3}" FontWeight="Bold" />
              <TextBlock Text="Top productos, margenes, comparacion de periodos y plataformas de pago." Style="{StaticResource MutedText}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding AnalyticsFromDateAsDateTime, Mode=TwoWay}" Width="130" Margin="0,0,8,0" />
              <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker SelectedDate="{Binding AnalyticsToDateAsDateTime, Mode=TwoWay}" Width="130" Margin="0,0,8,0" />
              <Button Content="Cargar" Command="{Binding LoadAnalyticsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
              <Button Command="{Binding ExportProfitPdfCommand}" Padding="8,0" Margin="0,0,6,0" ToolTip="Exportar PDF">
                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" />
              </Button>
              <Button Content="Excel" Command="{Binding ExportProfitExcelCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 2x2 grid of profitability cards -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Top 10 productos (real, proportional bars, descending units) -->
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="16,12,16,4">
                <materialDesign:PackIcon Kind="StarCircle" Width="16" Height="16" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Top 10 · Productos mas vendidos" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding TopSellerRows}" Margin="16,4,16,12" MaxHeight="280">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                      </Grid.ColumnDefinitions>
                      <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BrushSurfaceContainer}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource TextCaption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource TextSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Height="6" Background="{StaticResource BrushSurfaceContainer}" CornerRadius="3" Margin="0,4,0,0">
                          <Border Background="{StaticResource BrushPrimary}" CornerRadius="3" HorizontalAlignment="Left"
                                  Width="{Binding BarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=260}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding UnitsSold, StringFormat='{}{0}u'}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextCaption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Sin ventas en el periodo seleccionado." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,16"
                         Visibility="{Binding TopSellerRows.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <!-- Margen por categoria: no CategoryId/CategoryName field exists on ProductMarginResult,
               so a per-category breakdown cannot be computed without a new backend query (out of scope
               for this Presentation-only PR). Shown as an illustrative static placeholder. -->
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <materialDesign:PackIcon Kind="Shape" Width="16" Height="16" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Margen bruto por categoria" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="Datos ilustrativos — requiere agregar categoria a la consulta de margenes." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" />

              <TextBlock Text="Sin categorizar (ver Margen por producto abajo)" Style="{StaticResource TextSmall}" FontWeight="Medium" Margin="0,0,0,4" />
              <Border Height="8" Background="{StaticResource BrushSurfaceContainer}" CornerRadius="4" Margin="0,0,0,12">
                <Border Background="{StaticResource BrushWarning}" CornerRadius="4" HorizontalAlignment="Left" Width="120" />
              </Border>

              <!-- Margen por producto (real, reused from prior view) -->
              <TextBlock Text="Margen por producto" Style="{StaticResource TextSmall}" FontWeight="SemiBold" Margin="0,0,0,6" />
              <DataGrid ItemsSource="{Binding ProductMargins}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                  <DataGridTextColumn Header="Margen" Binding="{Binding GrossMargin, StringFormat='{}{0:N0}'}" Width="90" />
                  <DataGridTextColumn Header="Margen %" Binding="{Binding MarginPercent, StringFormat='{}{0:N1}%'}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Comparativa de periodos (real) -->
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Comparativa de periodos" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,12" />
              <UniformGrid Columns="3" DataContext="{Binding PeriodComparison}">
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Periodo actual" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Text="{Binding CurrentRevenue, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushPrimary}" />
                </StackPanel>
                <StackPanel Margin="8,0,8,0">
                  <TextBlock Text="Periodo anterior" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Text="{Binding PriorRevenue, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Diferencia" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Text="{Binding RevenueGrowthPercent, StringFormat='{}{0:+0.0;-0.0}%'}" FontWeight="Bold" FontFamily="Consolas">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DataContext.PeriodComparisonIsPositive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- Desglose por plataforma: real data from GetPlatformBreakdownAsync (groups by payment
               bank/platform, e.g. Nequi/Bancolombia). The wireframe's "POS vs. Cotizaciones convertidas"
               channel breakdown has no backing data (Sale has no quote-origin tracking field); relabeled
               to reflect what the real data represents instead of inventing a channel split. -->
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Desglose por plataforma de pago" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="Agrupado por banco/plataforma de pago registrada en cada transaccion." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" />
              <DataGrid ItemsSource="{Binding PlatformBreakdown}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Plataforma" Binding="{Binding Platform}" Width="*" />
                  <DataGridTextColumn Header="Monto" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="100" />
                  <DataGridTextColumn Header="Transacciones" Binding="{Binding TransactionCount}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- ══════════════════════ TAB: Cierres y arqueos (read-only) ══════════════════════ -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsClosingsSubtabActive, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid Margin="0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Ultimo cierre registrado -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <materialDesign:PackIcon Kind="Receipt" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Ultimo cierre registrado" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasLastClosedShift, Converter={StaticResource BoolToVisibilityConverter}}">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cajero" Style="{StaticResource TextSmall}" FontWeight="Medium" />
                <TextBlock Grid.Column="1" Text="{Binding LastClosedShiftCashier}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Apertura" Style="{StaticResource TextSmall}" FontWeight="Medium" />
                <TextBlock Grid.Column="1" Text="{Binding LastClosedShiftOpenSummary}" FontFamily="Consolas" Style="{StaticResource TextSmall}" />
              </Grid>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cierre" Style="{StaticResource TextSmall}" FontWeight="Medium" />
                <TextBlock Grid.Column="1" Text="{Binding LastClosedShiftCloseSummary}" FontFamily="Consolas" Style="{StaticResource TextSmall}" Foreground="{StaticResource BrushMuted}" />
              </Grid>

              <!-- Totals reuse the Operational subtab's currently loaded report period; documented as a
                   deviation since ICashClosingRepository has no per-closing query method yet. -->
              <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="6" Padding="12"
                      Visibility="{Binding HasOperationalTotalsForClosing, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total facturado (periodo cargado)" Style="{StaticResource TextSmall}" />
                    <TextBlock Grid.Column="1" Text="{Binding BilledTotalText}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" Foreground="{StaticResource BrushPrimary}" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Efectivo esperado" Style="{StaticResource TextSmall}" />
                    <TextBlock Grid.Column="1" Text="{Binding ExpectedDrawerCashText}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Digital" Style="{StaticResource TextSmall}" />
                    <TextBlock Grid.Column="1" Text="{Binding DigitalCollectedText}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" />
                  </Grid>
                  <TextBlock Text="Cifras del periodo cargado en Resumen operacional (no necesariamente el mismo rango exacto del turno)."
                             Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="Aun no hay cierres de turno registrados." Style="{StaticResource MutedText}"
                       Visibility="{Binding HasLastClosedShift, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />
          </StackPanel>
        </Border>

        <!-- Consulta de cierres -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <materialDesign:PackIcon Kind="ClipboardCheck" Width="18" Height="18" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Consulta de cierres" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
            </StackPanel>

            <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Que si hace este tab" Style="{StaticResource TextSmall}" FontWeight="SemiBold" />
                <TextBlock Text="Consultar arqueos ya cerrados, diferencias detectadas y exportar evidencia." Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushWarningContainer}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Que ya no hace" Style="{StaticResource TextSmall}" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}" />
                <TextBlock Text="El cierre operativo del turno no se ejecuta aqui. Se realiza desde Turnos para evitar duplicidad con reportes."
                           Foreground="{StaticResource BrushWarning}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Recent closings (real data via GetShiftsUseCase) -->
            <TextBlock Text="Cierres recientes" Style="{StaticResource TextSmall}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding RecentClosings}" MaxHeight="140" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CashierUsername}" Style="{StaticResource TextSmall}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ClosedAtFormatted}" FontFamily="Consolas" Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DifferenceLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DifferenceKind}" Value="success">
                              <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifferenceKind}" Value="primary">
                              <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifferenceKind}" Value="error">
                              <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Sin cierres registrados." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8"
                       Visibility="{Binding RecentClosings.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

            <!-- Retry: LoadClosingsCommand was previously defined but never bound anywhere, so a
                 failed auto-load on tab-open had no way to retry. Shown only while an error is active. -->
            <Button Content="Reintentar" Command="{Binding LoadClosingsCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Diferencia reportada (ultimo cierre)" Style="{StaticResource TextSmall}" />
                  <TextBlock Grid.Column="1" Text="{Binding LastClosingDifferenceLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LastClosingDifferenceKind}" Value="success">
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LastClosingDifferenceKind}" Value="primary">
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LastClosingDifferenceKind}" Value="error">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <!-- Reuses the Operational report export (no dedicated cash-closing export exists yet) -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Exportar evidencia" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ExportOperationalPdfCommand}" Padding="8,0" Margin="0,0,6,0" ToolTip="Exportar PDF">
                      <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" />
                    </Button>
                    <Button Content="Excel" Command="{Binding ExportOperationalExcelCommand}" Style="{StaticResource PrimaryButton}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Navigation to Turnos for the actual cash-closing action -->
            <Button Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding DataContext.AdminHubModules[4], RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Storefront" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="Ir a Turnos para cerrar caja" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
