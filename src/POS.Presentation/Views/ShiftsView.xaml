<UserControl x:Class="POS.Presentation.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ Active shift banner ══ -->
    <Border Visibility="{Binding HasActiveShift, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="{StaticResource BrushSuccessContainer}"
            BorderBrush="{StaticResource BrushSuccess}"
            BorderThickness="0,0,0,2"
            Padding="16,12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="RadioboxMarked" Width="20" Height="20"
                                 Foreground="{StaticResource BrushSuccess}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}">
            <Run Text="Turno activo — " /><Run Text="{Binding ActiveShiftCashier, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0">
            <Run Text="Abierto a las " /><Run Text="{Binding ActiveShiftOpenTime, Mode=OneWay}" />
            <Run Text=" · Base: " /><Run Text="{Binding ActiveShiftBaseCashFormatted, Mode=OneWay}" />
            <Run Text=" · Ventas: " /><Run Text="{Binding ActiveShiftSalesTotal, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="El cierre del efectivo se ejecuta aqui. Reportes solo consulta cierres ya completados."
                     Style="{StaticResource TextCaption}" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Column="2" Background="{StaticResource BrushSuccessContainer}" CornerRadius="3" Padding="6,2"
                VerticalAlignment="Center">
          <TextBlock Text="Abierto" Style="{StaticResource TextCaption}" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushSuccess}" />
        </Border>
      </Grid>
    </Border>

    <!-- ══ Main content: grid + action panel ══ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <!-- ══ Shift history grid ══ -->
      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Grid Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Historial de turnos" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate, Mode=TwoWay}"
                        Width="140" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource BrushMuted}"
                       VerticalAlignment="Center" Margin="8,0" />
            <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate, Mode=TwoWay}"
                        Width="140" />
            <Button Grid.Column="4" Command="{Binding ApplyDateFilterCommand}"
                    Padding="8,0" Margin="8,0,0,0" ToolTip="Filtrar">
              <materialDesign:PackIcon Kind="Filter" Width="16" Height="16" />
            </Button>
          </Grid>

          <!-- Grid header -->
          <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainer}" Padding="16,6" CornerRadius="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="CAJERO" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="1" Text="ESTADO" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="2" Text="APERTURA" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="3" Text="CIERRE" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
               <TextBlock Grid.Column="4" Text="BASE / ESP." Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="5" Text="VENTAS" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
              <TextBlock Grid.Column="6" Text="DIFERENCIA" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" />
            </Grid>
          </Border>

          <!-- Grid body -->
          <ListBox x:Name="ShiftsListBox"
                   Grid.Row="2"
                   ItemsSource="{Binding FilteredShifts}"
                   SelectedItem="{Binding SelectedShiftRow, Mode=TwoWay}"
                   SelectionChanged="ShiftsListBox_SelectionChanged"
                   BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="16,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="{Binding CashierUsername}" Style="{StaticResource TextBody}"
                                 FontWeight="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=weight}" />

                      <!-- Status chip -->
                      <Border Grid.Column="1" CornerRadius="3" Padding="6,2">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StatusChipKind}" Value="success">
                                <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                              <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusChipKind}" Value="success">
                                  <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <TextBlock Grid.Column="2" Text="{Binding OpenedAtFormatted}" FontFamily="Consolas" Style="{StaticResource TextSmall}" />
                      <TextBlock Grid.Column="3" Text="{Binding ClosedAtFormatted}" FontFamily="Consolas" Style="{StaticResource TextSmall}"
                                 Foreground="{StaticResource BrushMuted}" />
                       <StackPanel Grid.Column="4">
                         <TextBlock Text="{Binding OpeningCashFormatted}" FontFamily="Consolas" Style="{StaticResource TextBody}" />
                         <TextBlock Text="{Binding ExpectedCashFormatted}" FontFamily="Consolas" Style="{StaticResource TextSmall}"
                                    Foreground="{StaticResource BrushMuted}" />
                       </StackPanel>
                       <StackPanel Grid.Column="5">
                         <TextBlock Text="{Binding SalesTotalFormatted}" FontFamily="Consolas" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushPrimary}" />
                         <TextBlock Text="{Binding DigitalPaymentsFormatted}" FontFamily="Consolas" Style="{StaticResource TextSmall}"
                                    Foreground="{StaticResource BrushMuted}" />
                       </StackPanel>

                      <!-- Difference -->
                      <TextBlock Grid.Column="6" Text="{Binding DifferenceLabel}" FontFamily="Consolas" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DifferenceKind}" Value="success">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DifferenceKind}" Value="primary">
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DifferenceKind}" Value="error">
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <TextBlock Grid.Row="2" Text="Sin turnos en el rango seleccionado"
                     Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding FilteredShifts.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </Grid>
      </Border>

      <!-- ══ Right action panel ══ -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Abrir turno -->
          <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Header -->
              <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="LockOpen" Width="18" Height="18"
                                           Foreground="{StaticResource BrushSuccess}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="Abrir turno" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>

              <!-- Form -->
              <StackPanel Grid.Row="1" Margin="16,12">
                <TextBlock Text="Cajero" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedCashierUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Efectivo de base" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding OpeningCash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Notas de apertura" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding OpenNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Footer -->
              <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <Button Command="{Binding StartShiftCommand}" HorizontalAlignment="Stretch"
                        Background="{StaticResource BrushSuccess}" Foreground="White" FontWeight="SemiBold">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LockOpen" Width="16" Height="16" Margin="0,0,4,0" />
                    <TextBlock Text="Abrir turno" />
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
          </Border>

          <!-- Cerrar turno activo -->
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                  Visibility="{Binding HasActiveShift, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Header -->
              <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Lock" Width="18" Height="18"
                                           Foreground="{StaticResource BrushDanger}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="Cerrar turno activo" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>

              <!-- Form -->
              <StackPanel Grid.Row="1" Margin="16,12">
                <!-- Expected totals -->
                <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Efectivo esperado" Style="{StaticResource TextSmall}" />
                      <TextBlock Grid.Column="1" Text="{Binding ExpectedCashFormatted}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Digital" Style="{StaticResource TextSmall}" />
                      <TextBlock Grid.Column="1" Text="{Binding ExpectedDigitalFormatted}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextSmall}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="Efectivo contado" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CountedCash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />

                <!-- Live difference -->
                <Border Visibility="{Binding HasCloseDifference, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="success">
                          <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="primary">
                          <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="error">
                          <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding CloseDifferenceLabel}" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource TextSmall}">
                        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="success">
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="primary">
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CloseDifferenceKind}" Value="error">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>

                <TextBlock Text="Observaciones del cierre" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CloseNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Footer -->
              <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <Button Command="{Binding CloseShiftCommand}" HorizontalAlignment="Stretch"
                        Background="{StaticResource BrushDanger}" Foreground="White" FontWeight="SemiBold">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Lock" Width="16" Height="16" Margin="0,0,4,0" />
                    <TextBlock Text="Cerrar turno" />
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Message -->
    <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource MutedText}"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-20" FontSize="11" />
  </Grid>
</UserControl>
