<UserControl x:Class="POS.Presentation.Views.RolesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework">
  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedPermissionOptions" Source="{Binding PermissionOptions}">
      <CollectionViewSource.GroupDescriptions>
        <data:PropertyGroupDescription PropertyName="Module" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadRolesCommand}" Style="{StaticResource PrimaryButton}" />
          <StackPanel>
            <TextBlock Text="Roles" Style="{StaticResource TextH2}" FontWeight="Bold" />
            <TextBlock Text="Selecciona un rol para editar sus permisos." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding IsSystem, StringFormat=Sistema: {0}}" Style="{StaticResource MutedText}" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Nombre del rol" Style="{StaticResource MutedText}" />
          <TextBox Text="{Binding RoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Crear rol" Command="{Binding CreateRoleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Guardar cambios" Command="{Binding SaveRoleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Desactivar" Command="{Binding DeactivateRoleCommand}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,12">
          <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedPermissionOptions}}">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,4" /></DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Key}"
                          IsChecked="{Binding IsGranted, Mode=TwoWay}"
                          IsEnabled="{Binding IsEnabled}"
                          Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding HasError, StringFormat=Error: {0}}" Foreground="{StaticResource BrushDanger}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
