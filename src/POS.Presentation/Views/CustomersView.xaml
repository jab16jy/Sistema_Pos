<UserControl x:Class="POS.Presentation.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Clientes" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Buscar cliente" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Nombre, documento, teléfono o correo" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Buscar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" />
            <CheckBox IsChecked="{Binding IncludeInactive, Mode=TwoWay}" Content="Incluir inactivos" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" MaxHeight="460">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Identification}" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Text="{Binding Phone}" Style="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Datos del cliente" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox Text="{Binding FullName, Mode=TwoWay}" Tag="Nombre completo" Margin="0,0,0,8" />
          <TextBox Text="{Binding Identification, Mode=TwoWay}" Tag="Identificación" Margin="0,0,0,8" />
          <TextBox Text="{Binding Phone, Mode=TwoWay}" Tag="Teléfono" Margin="0,0,0,8" />
          <TextBox Text="{Binding Email, Mode=TwoWay}" Tag="Correo electrónico" Margin="0,0,0,8" />
          <TextBox Text="{Binding Address, Mode=TwoWay}" Tag="Dirección" AcceptsReturn="True" Height="70" Margin="0,0,0,8" />
          <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Content="Activo" Margin="0,0,0,12" />
          <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Historial" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Button Content="Ver historial" Command="{Binding OpenHistoryCommand}" Margin="0,0,0,12" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding HistoryEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <StackPanel>
                      <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource MutedText}" FontSize="11" />
                      <TextBlock Text="{Binding Amount}" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
