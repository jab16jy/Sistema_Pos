<UserControl x:Class="POS.Presentation.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushAccent" Color="#0D9488" />
    <Style x:Key="ClientesLinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="ClienteHistoryRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ToolTip" Value="Abrir factura" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.75" />
          <Setter Property="ToolTip" Value="Movimiento sin factura consultable" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="28*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="36*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="36*" />
    </Grid.ColumnDefinitions>

    <!-- ══ COL 1: Lista ══ -->
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Tag="Nombre, ID o teléfono..." />
          <Button Grid.Column="1"
                  Command="{Binding LoadCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="8,0,0,0"
                  Padding="10,0">
            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" />
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding TotalCustomersCount}" Style="{StaticResource TextH3}" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="TOTAL" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding ActiveCustomersCount}" Style="{StaticResource TextH3}" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center" />
              <TextBlock Text="ACTIVOS" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <ListBox Grid.Row="2"
                  ItemsSource="{Binding Customers}"
                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                  BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrushPrimaryContainer}">
                  <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Style="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}">
                        <Binding Path="Phone" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                          <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="11" FontWeight="Medium">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Inactivo" />
                        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Text" Value="Activo" />
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ══ COL 2: Formulario ══ -->
    <Border Grid.Column="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="12,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Nuevo cliente" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasSelectedCustomer}" Value="True">
                    <Setter Property="Text" Value="Editar cliente" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Grid.Column="2"
                  Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="11" FontWeight="Medium">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Inactivo" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter Property="Text" Value="Activo" />
                      <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="16,0,16,12">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
              <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource BrushPrimaryContainer}">
                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Style="{StaticResource TextH2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding FullName}" Style="{StaticResource TextH3}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Nombre completo *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding FullName, Mode=TwoWay}" Tag="María López" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Cédula / ID" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding Identification, Mode=TwoWay}" Tag="12345678" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Teléfono" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding Phone, Mode=TwoWay}" Tag="3001234567" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Email" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding Email, Mode=TwoWay}" Tag="cliente@email.com" />
              </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="Dirección" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding Address, Mode=TwoWay}" Tag="Calle 45 #12-34, Bogotá" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <TextBlock Text="Estado" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Medium">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Inactivo" />
                    <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Text" Value="Activo" />
                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>

            <Border Background="{StaticResource BrushWarningContainer}"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,8"
                    Visibility="{Binding LoyaltyPoints, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
                <TextBlock Foreground="{StaticResource BrushWarning}" Style="{StaticResource TextSmall}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} puntos de lealtad disponibles">
                      <Binding Path="LoyaltyPoints" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Background="{Binding CurrentTierColorBrush}"
                    CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding HasCurrentTier, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Medal" Width="16" Height="16" Foreground="{Binding CurrentTierTextForegroundBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="{Binding CurrentTierName}" FontWeight="Bold" FontSize="12" Foreground="{Binding CurrentTierTextForegroundBrush}" />
                  <TextBlock Text="{Binding CurrentTierBenefit}" FontSize="11" Foreground="{Binding CurrentTierTextForegroundBrush}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Button Content="Reglas de lealtad"
                    Style="{StaticResource ClientesLinkButton}"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding DataContext.AdminHubModules[5], RelativeSource={RelativeSource AncestorType=Window}}" />

            <Border Background="{StaticResource BrushSurfaceContainer}"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,8,0,0"
                    Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}">
              <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Grid.Column="1"
                    Content="Eliminar"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource ClientesLinkButton}"
                    Foreground="{StaticResource BrushDanger}"
                    Margin="8,0,0,0"
                    Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}" />
            <Button Grid.Column="3" Content="Nuevo" Command="{Binding NewCommand}" Style="{StaticResource ClientesLinkButton}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ══ COL 3: Historial ══ -->
    <Border Grid.Column="4" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <materialDesign:PackIcon Kind="History" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Historial" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding HistoryPurchaseCount}" Style="{StaticResource TextH3}" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="COMPRAS" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding HistoryTotalFormatted}" Style="{StaticResource TextH3}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" />
              <TextBlock Text="TOTAL" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding LoyaltyPoints}" Style="{StaticResource TextH3}" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" HorizontalAlignment="Center" />
              <TextBlock Text="PUNTOS" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,1" Padding="8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding OutstandingBalanceFormatted}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center" />
              <TextBlock Text="SALDO" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Panel de Canjeo de Beneficios: Puntos de Lealtad -> Tier -> Canjeo de Beneficios -->
        <Border Margin="0,10,0,10" Padding="14,12" CornerRadius="8"
                Background="{StaticResource BrushWarningContainer}"
                BorderBrush="{StaticResource BrushWarning}" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CanClaimBenefits}" Value="True" />
                    <Condition Binding="{Binding HasSelectedCustomer}" Value="True" />
                    <Condition Binding="{Binding HasPoints}" Value="True" />
                    <Condition Binding="{Binding HasAvailableBenefits}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="GiftOutline" Width="18" Height="18"
                                         Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="CANJEO DE BENEFICIOS" Style="{StaticResource TextBody}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding AvailableBenefits}"
                        SelectedItem="{Binding SelectedBenefit, Mode=TwoWay}"
                        DisplayMemberPath="DisplayLabel"
                        materialDesign:HintAssist.Hint="Selecciona un beneficio a canjear"
                        VerticalAlignment="Center" />
              <Button Grid.Column="1" Margin="10,0,0,0"
                      Style="{StaticResource PrimaryButton}"
                      Command="{Binding ClaimBenefitCommand}">
                <Button.ContentTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <TextBlock Text="Canjear" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </Button.ContentTemplate>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="HistFilterAll" GroupName="HistFilter" IsChecked="True" Style="{StaticResource SubtabItemStyle}" Content="Todo"
                       Command="{Binding SetHistoryFilterCommand}" CommandParameter="all" />
          <RadioButton x:Name="HistFilterSale" GroupName="HistFilter" Style="{StaticResource SubtabItemStyle}" Content="Ventas"
                       Command="{Binding SetHistoryFilterCommand}" CommandParameter="sale" />
          <RadioButton x:Name="HistFilterQuote" GroupName="HistFilter" Style="{StaticResource SubtabItemStyle}" Content="Cotizaciones"
                       Command="{Binding SetHistoryFilterCommand}" CommandParameter="quote" />
          <RadioButton x:Name="HistFilterRedemption" GroupName="HistFilter" Style="{StaticResource SubtabItemStyle}" Content="Redención de puntos"
                       Command="{Binding SetHistoryFilterCommand}" CommandParameter="redemption" />
        </StackPanel>

        <StackPanel Grid.Row="3">

        <!-- Registrar abono: visible solo cuando el cliente tiene saldo pendiente -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                Background="{StaticResource BrushPrimaryContainer}"
                Visibility="{Binding HasOutstandingBalance, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="REGISTRAR ABONO" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding OpenReceivables}" SelectedItem="{Binding SelectedReceivable}" Margin="0,0,0,8">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <Run Text="Factura " /><Run Text="{Binding InvoiceNumber, Mode=OneWay}" />
                    <Run Text=" — saldo " /><Run Text="{Binding OutstandingBalance, Mode=OneWay, StringFormat={}{0:C0}}" />
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding SettlementPaymentMethods}"
                      SelectedItem="{Binding SelectedSettlementPaymentMethod}"
                      DisplayMemberPath="Label"
                      Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding SettlementPaymentPlatforms}"
                      SelectedItem="{Binding SelectedSettlementBankOrPlatform}"
                      Visibility="{Binding IsSettlementTransfer, Converter={StaticResource BoolToVisibilityConverter}}"
                      materialDesign:HintAssist.Hint="Plataforma de transferencia"
                      Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" VerticalContentAlignment="Center"
                       materialDesign:HintAssist.Hint="Monto del abono"
                       Text="{Binding AbonoAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="Abonar" Margin="8,0,0,0"
                      Style="{StaticResource PrimaryButton}"
                      Command="{Binding AbonarCommand}" />
            </Grid>
            <Button Content="Pagar todo el saldo de todas las facturas"
                    Margin="0,8,0,0"
                    Style="{StaticResource ClientesLinkButton}"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding CanPagarTodoSaldo}"
                    Click="PagarTodoSaldoButton_OnClick" />
          </StackPanel>
        </Border>

        </StackPanel>

        <Grid Grid.Row="4">
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Visibility="{Binding SelectedCustomer, Converter={StaticResource InverseNullToVisibilityConverter}}">
            <materialDesign:PackIcon Kind="AccountSearch" Width="40" Height="40" Foreground="{StaticResource BrushBorder}" HorizontalAlignment="Center" />
            <TextBlock Text="Selecciona un cliente para ver su historial"
                       Style="{StaticResource MutedText}"
                       TextAlignment="Center"
                       MaxWidth="220"
                       Margin="0,12,0,0" />
          </StackPanel>

          <ScrollViewer Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding FilteredHistoryEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ClienteHistoryRowButton}"
                          Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Border Padding="12,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Kind}" Value="Quote">
                                <Setter Property="Margin" Value="24,0,0,0" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Quote">
                                  <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Redemption">
                                  <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                  <Setter Property="Background" Value="#F3E8FF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Kind}" Value="Quote" />
                                    <Condition Binding="{Binding Status}" Value="Cancelled" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <materialDesign:PackIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                              <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Receipt" />
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="Quote">
                                    <Setter Property="Kind" Value="FileDocumentOutline" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="Redemption">
                                    <Setter Property="Kind" Value="GiftOutline" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="Returned">
                                    <Setter Property="Kind" Value="KeyboardReturn" />
                                    <Setter Property="Foreground" Value="#7C3AED" />
                                  </DataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding Kind}" Value="Quote" />
                                      <Condition Binding="{Binding Status}" Value="Cancelled" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Kind" Value="FileCancelOutline" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </materialDesign:PackIcon.Style>
                          </materialDesign:PackIcon>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Reference}" FontWeight="Medium" />
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Anulada" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="#F3E8FF" BorderBrush="#8B5CF6" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Devuelta" FontSize="9" FontWeight="Bold" Foreground="#7C3AED" />
                            </Border>
                            <!-- Redemption statuses carry their own prefix so the Anulada/Devuelta
                                 chips above never fire on a points row. -->
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource BrushWarningContainer}" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="RedemptionPending">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Pendiente" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource BrushSuccessContainer}" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="RedemptionDelivered">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Entregado" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource BrushDangerSoft}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="RedemptionCancelled">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="Anulado" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="{}{0:d}">
                                <Binding Path="OccurredAt" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                          <TextBlock Text="Abrir factura" FontSize="10">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SaleId}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="Sale">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="Redemption">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <Button Content="Marcar entregado" FontSize="10" Margin="0,0,12,0"
                                    Command="{Binding DataContext.DeliverClaimCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ClientesLinkButton}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="RedemptionPending">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <!-- Anular devuelve puntos, así que va detrás de su propio permiso. -->
                            <Button Content="Anular" FontSize="10"
                                    Command="{Binding DataContext.CancelClaimCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ClientesLinkButton}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                  <Style.Triggers>
                                    <MultiDataTrigger>
                                      <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.CanCancelClaims, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                        <Condition Binding="{Binding Status}" Value="RedemptionPending" />
                                      </MultiDataTrigger.Conditions>
                                      <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                      <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.CanCancelClaims, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                        <Condition Binding="{Binding Status}" Value="RedemptionDelivered" />
                                      </MultiDataTrigger.Conditions>
                                      <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C0}}" FontWeight="Bold" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                  <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                  <Setter Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                  <Setter Property="Foreground" Value="#7C3AED" />
                                </DataTrigger>
                                <!-- A claim is priced in points, not pesos; the cost is in the reference. -->
                                <DataTrigger Binding="{Binding Kind}" Value="Redemption">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
