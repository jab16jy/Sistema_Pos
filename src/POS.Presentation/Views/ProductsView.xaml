<UserControl x:Class="POS.Presentation.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Productos" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Buscar producto" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Nombre o código de barras" Margin="0,0,0,8" />
          <Button Content="Buscar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
          <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" MaxHeight="500">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Barcode}" Style="{StaticResource MutedText}" FontSize="11" />
                  <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                    <Run Text="Stock: " />
                    <Run Text="{Binding CurrentStock, Mode=OneWay}" />
                    <Run Text=" | Precio: $" />
                    <Run Text="{Binding SalePrice, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Text="Datos del producto" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox Text="{Binding Name, Mode=TwoWay}" Tag="Nombre del producto" Margin="0,0,0,8" />
            <TextBox Text="{Binding Description, Mode=TwoWay}" Tag="Descripción" AcceptsReturn="True" Height="70" Margin="0,0,0,8" />
            <TextBox Text="{Binding Barcode, Mode=TwoWay}" Tag="Código de barras (opcional)" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Precio de costo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CostPrice, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Precio de venta" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding SalePrice, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Stock actual" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CurrentStock, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Stock mínimo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding MinimumStock, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
              <Button Content="Eliminar" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
              <Button Content="Limpiar" Command="{Binding ClearCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
