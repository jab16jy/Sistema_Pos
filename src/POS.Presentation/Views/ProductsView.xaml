<UserControl x:Class="POS.Presentation.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushAccent" Color="#0D9488" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ Subtab bar ══ -->
    <Border Grid.Row="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="Productos" GroupName="ProductSubtabs"
                     IsChecked="{Binding IsProductsSubtabActive, Mode=TwoWay}"
                     Style="{StaticResource SubtabItemStyle}" />
        <RadioButton Content="Categorias" GroupName="ProductSubtabs"
                     IsChecked="{Binding IsCategoriesSubtabActive, Mode=TwoWay}"
                     Style="{StaticResource SubtabItemStyle}" />
      </StackPanel>
    </Border>

    <!-- ══ TAB: Productos ══ -->
    <Grid Grid.Row="1" Visibility="{Binding IsProductsSubtabActive, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40*" MinWidth="280" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="60*" />
      </Grid.ColumnDefinitions>

      <!-- ── Left: Product list ── -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Nombre o codigo de barras..." />
            <Button Grid.Column="1" Command="{Binding LoadCommand}"
                    Padding="8,0" Margin="6,0,0,0" ToolTip="Buscar productos">
              <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" />
            </Button>
            <Button Grid.Column="2" Command="{Binding ToggleCsvCommand}"
                    Padding="8,0" Margin="6,0,0,0" ToolTip="Importar CSV">
              <materialDesign:PackIcon Kind="FileUpload" Width="16" Height="16" />
            </Button>
            <Button Grid.Column="3" Command="{Binding NewCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="10,0" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="Nuevo" Margin="4,0,0,0" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Product list -->
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Products}"
                   SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                   BorderThickness="0"
                   Background="Transparent">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Thumbnail -->
                  <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource BrushSurfaceContainer}">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18"
                                              Foreground="{StaticResource BrushMuted}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <!-- Info -->
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                      <Run Text="{Binding Barcode, Mode=OneWay, TargetNullValue='—'}" />
                      <Run Text=" · " />
                      <Run Text="{Binding CategoryName, Mode=OneWay, TargetNullValue='Sin categoría'}" />
                    </TextBlock>
                  </StackPanel>

                  <!-- Price + stock chip -->
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Right">
                      <Run Text="$ " />
                      <Run Text="{Binding SalePrice, Mode=OneWay, StringFormat='N0'}" />
                    </TextBlock>
                    <!-- Stock status chip -->
                    <Border Margin="0,4,0,0" HorizontalAlignment="Right" Padding="6,2" CornerRadius="3">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                              <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                              <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="En stock" />
                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                <Setter Property="Text" Value="Sin stock" />
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Text" Value="Stock bajo" />
                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding Products.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
            <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource BrushSurfaceContainer}" HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28"
                                        Foreground="{StaticResource BrushBorder}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Sin resultados" Style="{StaticResource TextH3}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
            <TextBlock Text="Intenta con otro nombre o codigo de barras." Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Right: Form ── -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Form header -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20"
                                      Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding FormTitle}" Style="{StaticResource TextH3}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <!-- Status chip -->
            <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                    Visibility="{Binding ShowFormStatusChip, Converter={StaticResource BoolToVisibilityConverter}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FormStatusChipKind}" Value="error">
                      <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FormStatusChipKind}" Value="warning">
                      <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding FormStatusChipLabel}" FontSize="11" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FormStatusChipKind}" Value="error">
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding FormStatusChipKind}" Value="warning">
                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </Grid>

          <!-- Form body -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!-- Name -->
              <TextBlock Text="Nombre del producto *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding Name, Mode=TwoWay}" Tag="Ibuprofeno 400mg · Caja x10" Margin="0,0,0,10" />

              <!-- Description -->
              <TextBlock Text="Descripcion" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding Description, Mode=TwoWay}" Tag="Descripcion del producto (opcional)"
                       AcceptsReturn="True" Height="64" Margin="0,0,0,10" />

              <!-- Barcode + Category -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                 <StackPanel>
                   <TextBlock Text="Codigo de barras" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                   <TextBox Text="{Binding Barcode, Mode=TwoWay}" Tag="7770001234567" />
                   <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                     <Button Command="{Binding GenerateInternalBarcodeCommand}" Padding="8,4" Margin="0,0,6,0">
                       <StackPanel Orientation="Horizontal">
                         <materialDesign:PackIcon Kind="Barcode" Width="14" Height="14" Margin="0,0,4,0" />
                         <TextBlock Text="Generar interno" />
                       </StackPanel>
                     </Button>
                     <Button Command="{Binding PrintLabelCommand}" Padding="8,4">
                       <StackPanel Orientation="Horizontal">
                         <materialDesign:PackIcon Kind="Printer" Width="14" Height="14" Margin="0,0,4,0" />
                         <TextBlock Text="Imprimir etiqueta" />
                       </StackPanel>
                     </Button>
                   </StackPanel>
                 </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Categoria" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding Categories}"
                            SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                            SelectedValuePath="Id"
                            DisplayMemberPath="Name"
                            Tag="Selecciona categoria" />
                </StackPanel>
               </Grid>

               <TextBlock Text="Proveedores de este producto (solo lectura)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
               <DataGrid ItemsSource="{Binding SupplierRelationships}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150" Margin="0,0,0,10">
                 <DataGrid.Columns>
                   <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*" />
                   <DataGridTextColumn Header="SKU" Binding="{Binding SupplierSku}" Width="90" />
                   <DataGridTextColumn Header="Unidad" Binding="{Binding PurchaseUnitName}" Width="90" />
                   <DataGridTextColumn Header="Factor" Binding="{Binding UnitsPerPurchaseUnit}" Width="65" />
                   <DataGridTextColumn Header="Costo" Binding="{Binding PurchaseUnitCost, StringFormat=N2}" Width="85" />
                   <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="130" />
                 </DataGrid.Columns>
               </DataGrid>

               <!-- Prices -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Precio de costo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding CostPrice, Mode=TwoWay}" Tag="0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Precio de venta" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding SalePrice, Mode=TwoWay}" Tag="0" />
                </StackPanel>
              </Grid>

              <!-- Margin preview -->
              <Border Margin="0,0,0,10" Padding="8,6" CornerRadius="4"
                      Visibility="{Binding HasMarginPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMarginNegative}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="TrendingUp" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                    <materialDesign:PackIcon.Style>
                      <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMarginNegative}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </materialDesign:PackIcon.Style>
                  </materialDesign:PackIcon>
                  <TextBlock Text="{Binding MarginDisplay}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMarginNegative}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- Stock fields -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding StockFieldLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding CurrentStock, Mode=TwoWay}" Tag="0" IsEnabled="{Binding IsStockEditable}" />
                  <TextBlock Text="Ajusta el stock desde Inventario" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0"
                             Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Stock minimo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding MinimumStock, Mode=TwoWay}" Tag="5" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="IVA %" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding TaxRate, Mode=TwoWay}" Tag="19" />
                </StackPanel>
              </Grid>

              <!-- Box presentation (optional): sell the same product by the box at an independent price -->
              <TextBlock Text="Presentación por caja (opcional)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Unidades por caja" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding UnitsPerBox, Mode=TwoWay, TargetNullValue=''}" Tag="0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Precio por caja" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox Text="{Binding BoxPrice, Mode=TwoWay, TargetNullValue=''}" Tag="0" />
                </StackPanel>
              </Grid>

              <!-- Stock status preview -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                          Visibility="{Binding HasStockStatusPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Estado calculado:" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Padding="6,2" CornerRadius="3">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                          <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                          <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding StockStatusLabel}" FontSize="11" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding StockStatusKind}" Value="error">
                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding StockStatusKind}" Value="warning">
                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </StackPanel>

              <!-- CSV collapsible section -->
              <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
                <StackPanel>
                  <Button Command="{Binding ToggleCsvCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <materialDesign:PackIcon Kind="FileUpload" Width="18" Height="18"
                                                Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Text="Importar desde CSV o XLSX" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                      <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18"
                                                Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                  </Button>

                  <StackPanel Visibility="{Binding IsCsvSectionOpen, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0">
                    <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                      <TextBlock FontFamily="Consolas" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap">
                        Columnas esperadas (formato propio):
                        <LineBreak />
                        name, categoryId, costPrice, salePrice,
                        <LineBreak />
                        currentStock, minimumStock, description,
                        <LineBreak />
                        barcode, taxRate
                        <LineBreak />
                        También acepta exportes de Tipo, Código,
                        <LineBreak />
                        Nombre, Precios, Impuestos, Stock, Estado.
                      </TextBlock>
                    </Border>
                    <TextBlock Text="Archivo CSV o XLSX" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding CsvPath, Mode=TwoWay}" Tag="C:\ruta\archivo.csv o .xlsx" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Examinar" Click="BrowseCsvFile_OnClick" Margin="8,0,0,0" />
                    </Grid>
                    <Button Command="{Binding ImportCsvCommand}" HorizontalAlignment="Left" Padding="12,6">
                      <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Importar productos" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Form actions -->
          <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Guardar" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Command="{Binding DeleteCommand}"
                      Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolToVisibilityConverter}}"
                      Foreground="{StaticResource BrushDanger}" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Eliminar" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3" Command="{Binding ClearCommand}" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Limpiar" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ══ TAB: Categorias ══ -->
    <Grid Grid.Row="1" DataContext="{Binding CategoriesEditor}"
           Visibility="{Binding DataContext.IsCategoriesSubtabActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="240" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: Category grid -->
      <Border Grid.Row="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,12">
            <TextBlock Text="Categorias" Style="{StaticResource TextH3}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="10,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Nueva" />
              </StackPanel>
            </Button>
          </Grid>

          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
              <DataGridTemplateColumn Header="Estado" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Padding="6,2" CornerRadius="3">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                              <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Activa" />
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Text" Value="Inactiva" />
                                <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Right: Category form -->
      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="Shape" Width="20" Height="20"
                                      Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Nueva categoria" Style="{StaticResource TextH3}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding SelectedCategory, Converter={StaticResource InverseNullToVisibilityConverter}}" />
            <TextBlock Text="Editando categoria" Style="{StaticResource TextH3}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>

          <TextBlock Text="Nombre de la categoria *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
          <TextBox Text="{Binding Name, Mode=TwoWay}" Tag="Ej: Cosmeticos" Margin="0,0,0,12" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Activa" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Guardar" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ClearCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Limpiar" />
              </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                    Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Eliminar" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12"
                       Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="FolderMultiple" Width="20" Height="20"
                                      Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Agrupar productos por categoría" Style="{StaticResource TextH3}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding ActiveCategories}"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding AssignmentCategoryId, Mode=TwoWay}"
                      Tag="Categoría destino" />
            <TextBox Grid.Column="2" Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar productos por nombre o código">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding LoadAssignmentProductsCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="4" Command="{Binding LoadAssignmentProductsCommand}" Style="{StaticResource PrimaryButton}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Buscar" />
              </StackPanel>
            </Button>
          </Grid>

          <DataGrid x:Name="AssignmentGrid" Grid.Row="2" ItemsSource="{Binding AssignmentProducts}" IsReadOnly="False"
                    AutoGenerateColumns="False" MinHeight="120"
                    SelectionChanged="AssignmentGrid_SelectionChanged"
                    PreviewKeyDown="AssignmentGrid_PreviewKeyDown">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Agrupar seleccionados" Click="GroupSelectedPopup_Click">
                  <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FolderMultiple" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Desmarcar seleccionados" Click="UngroupSelected_Click">
                  <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Close" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Asignar" Binding="{Binding IsSelected, Mode=TwoWay}" Width="80" />
              <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="Categoría actual" Binding="{Binding CategoryName}" Width="220" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding SelectedProductCount, StringFormat=Seleccionados: {0}}"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="GroupSelectedBtn" Click="GroupSelectedPopup_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="FolderMultiple" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Agrupar seleccionados" />
                </StackPanel>
              </Button>
              <Button Command="{Binding AssignProductsCommand}" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="FolderMove" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Asignar categoría" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
