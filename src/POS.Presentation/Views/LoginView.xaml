<UserControl x:Class="POS.Presentation.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:POS.Presentation.Helpers"
             MinWidth="900"
             MinHeight="620">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8F9FA" Offset="0" />
        <GradientStop Color="#ECFEFF" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Border Width="440"
            Background="{StaticResource BrushSurface}"
            CornerRadius="12"
            Padding="34"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource CardShadow}">
      <StackPanel>
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
          <Border Width="58"
                  Height="58"
                  CornerRadius="16"
                  Background="{StaticResource BrushSurfaceAlt}"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,14">
            <TextBlock Text="+"
                       Foreground="{StaticResource BrushAccent}"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Esthetic Medical Store"
                     FontSize="27"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Venta rapida, limpia y segura"
                     Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center"
                     Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Escribe el usuario asignado por el administrador." />

        <TextBlock Text="Contrasena" FontWeight="SemiBold" Margin="0,16,0,6" />
        <PasswordBox helpers:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Escribe tu contrasena de acceso." />

        <Border Background="#E0F2FE"
                BorderBrush="#BAE6FD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,22,0,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="i"
                       Width="22"
                       Height="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Column="1"
                       Text="Ingresa con el usuario asignado. Si olvidaste tu clave, llama al administrador."
                       Foreground="{StaticResource BrushPrimaryDark}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Button Content="Iniciar sesion"
                Command="{Binding LoginCommand}"
                Style="{StaticResource PrimaryButton}"
                Height="46"
                HorizontalAlignment="Stretch" />

        <TextBlock Text="Atajo: Enter inicia sesion"
                   Style="{StaticResource MutedText}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
