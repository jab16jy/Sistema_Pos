<UserControl x:Class="POS.Presentation.Views.QuoteHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding FilterCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrar por cliente" />
      <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFrom, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}" Margin="8,0,0,0" />
      <DatePicker Grid.Column="2" SelectedDate="{Binding FilterTo, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}" Margin="8,0,0,0" />
      <Button Grid.Column="3" Content="Buscar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding StatusMessage, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="#EEF2FF" Margin="0,0,0,8" >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Número" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="1" Text="Cliente" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="2" Text="Total" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="3" Text="Estado" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="4" Text="Vence" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="5" Text="Enviar" FontWeight="SemiBold" Margin="8" />
          <TextBlock Grid.Column="6" Text="Convertir" FontWeight="SemiBold" Margin="8" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Quotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding QuoteNumber}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding CustomerName}" />
                      <TextBlock Text="{Binding CustomerEmail}" Visibility="{Binding CustomerEmail, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TotalFormatted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding ExpiresAt}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                      <Button Content="Email" Command="{Binding DataContext.SendByEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                      <Button Content="WhatsApp" Command="{Binding DataContext.SendByWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <Button Grid.Column="6" Content="Venta" Command="{Binding DataContext.ConvertToSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="← Anterior" Command="{Binding PreviousPageCommand}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Página " />
        <TextBlock Text="{Binding CurrentPage}" />
        <TextBlock Text=" — " />
        <TextBlock Text="{Binding TotalCount}" />
        <TextBlock Text=" total" />
        <TextBlock Text="   Cargando..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>
      <Button Grid.Column="2" Content="Siguiente →" Command="{Binding NextPageCommand}" />
    </Grid>
  </Grid>
</UserControl>
