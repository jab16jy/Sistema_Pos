<UserControl x:Class="POS.Presentation.Views.QuoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushAccent" Color="#0D9488" />
    <Style x:Key="GhostQuoteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
    </Style>
    <Style x:Key="AddToCartIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Subtab bar (Nueva cotización / Historial) -->
    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabNueva" GroupName="QuoteTabs" Style="{StaticResource SubtabItemStyle}" IsChecked="True">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="PlusCircle" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="Nueva cotización" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabHistorial" GroupName="QuoteTabs" Style="{StaticResource SubtabItemStyle}">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="History" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="Historial" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- ════ TAB: Nueva cotización ════ -->
    <Grid Grid.Row="1" Visibility="{Binding IsChecked, ElementName=TabNueva, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="60*" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel Margin="14">
            <TextBlock Text="Datos del cliente" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Nombre *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="María López" />
                  <Button Grid.Column="1"
                          Content="Buscar"
                          Command="{Binding SearchCustomerCommand}"
                          Style="{StaticResource PrimaryButton}"
                          Margin="8,0,0,0"
                          Padding="10,0" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Teléfono" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CustomerPhone, Mode=TwoWay}" Tag="3001234567" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SelectedCustomerLabel}"
                       Visibility="{Binding SelectedCustomerLabel, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}"
                       Style="{StaticResource MutedText}"
                       FontSize="11"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding CustomerSearchResults}"
                          Visibility="{Binding CustomerSearchResults.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}"
                          Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding FullName}" FontWeight="Medium" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}ID {0} · {1}">
                              <Binding Path="Identification" />
                              <Binding Path="Phone" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Usar"
                              Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource GhostQuoteButton}"
                              Padding="8,4" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Email" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding CustomerEmail, Mode=TwoWay}" Tag="cliente@email.com" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Validez (días)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <xctk:IntegerUpDown Value="{Binding ValidityDays, Mode=TwoWay}" Minimum="1" Maximum="365" Height="36" />
              </StackPanel>
            </Grid>
            <StackPanel>
              <TextBlock Text="Observaciones" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding Observations, Mode=TwoWay}" Tag="Notas para el cliente..." AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="14,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Agregar producto" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Margin="14,0,14,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar producto..." />
              <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            </Grid>
            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="14,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="PackageVariant" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                          <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="{}{0:C0}">
                                <Binding Path="UnitPrice" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource AddToCartIconButton}"
                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <materialDesign:PackIcon Kind="PlusCircle" Foreground="{StaticResource BrushPrimary}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="CartOutline" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Carrito de cotización" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Border Grid.Column="2" Style="{StaticResource ChipStyle}">
              <TextBlock Style="{StaticResource TextCaption}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} ítems">
                    <Binding Path="CartItems.Count" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </Grid>

          <Grid Grid.Row="1" Background="{StaticResource BrushSurfaceContainer}" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Producto" Style="{StaticResource MutedText}" FontSize="11" Margin="14,8" />
            <TextBlock Grid.Column="1" Text="Cant." Style="{StaticResource MutedText}" FontSize="11" Margin="8" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Precio" Style="{StaticResource MutedText}" FontSize="11" Margin="8" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource MutedText}" FontSize="11" Margin="8" HorizontalAlignment="Right" />
          </Grid>

          <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding CartItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
              <materialDesign:PackIcon Kind="FileDocumentOutline" Width="36" Height="36" Foreground="{StaticResource BrushBorder}" HorizontalAlignment="Center" />
              <TextBlock Text="Selecciona productos para cotizar" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding CartItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="14,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProductName}" FontWeight="Medium" VerticalAlignment="Center" />
                        <xctk:DecimalUpDown Grid.Column="1" Value="{Binding Quantity, Mode=TwoWay}" Minimum="0.01" Height="28" HorizontalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:C0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat={}{0:C0}}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Grid.Column="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="0"
                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource BrushDanger}" Width="15" Height="15" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding ValidationMessage}" Visibility="{Binding ValidationMessage, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="Total" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding TotalFormatted}" Style="{StaticResource TextH1}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SendByWhatsAppCommand}" IsEnabled="{Binding IsConfirming, Converter={StaticResource BooleanNegationConverter}}" Style="{StaticResource GhostQuoteButton}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="WhatsApp" Width="16" Height="16" Margin="0,0,4,0" />
                    <TextBlock Text="WhatsApp" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding SendByEmailCommand}" IsEnabled="{Binding IsConfirming, Converter={StaticResource BooleanNegationConverter}}" Style="{StaticResource GhostQuoteButton}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Email" Width="16" Height="16" Margin="0,0,4,0" />
                    <TextBlock Text="Email" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding ConfirmCommand}" IsEnabled="{Binding IsConfirming, Converter={StaticResource BooleanNegationConverter}}" Style="{StaticResource AccentButton}">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Margin="0,0,4,0" />
                    <TextBlock Text="Confirmar cotización" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ════ TAB: Historial ════ -->
    <Grid x:Name="HistorialTabRoot"
          Grid.Row="1"
          DataContext="{Binding HistoryViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Visibility="{Binding IsChecked, ElementName=TabHistorial, Converter={StaticResource BoolToVisibilityConverter}}">
      <Border Style="{StaticResource Card}"
              Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FilterCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Cliente..." />
            <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFrom, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="→" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker Grid.Column="3" SelectedDate="{Binding FilterTo, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeConverter}}" />
            <Button Grid.Column="5" Content="Buscar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
          </Grid>

          <Grid Grid.Row="1" Background="{StaticResource BrushSurfaceContainer}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="N° Cotiz." Style="{StaticResource MutedText}" FontSize="11" Margin="14,8" />
            <TextBlock Grid.Column="1" Text="Cliente" Style="{StaticResource MutedText}" FontSize="11" Margin="8" />
            <TextBlock Grid.Column="2" Text="Total" Style="{StaticResource MutedText}" FontSize="11" Margin="8" />
            <TextBlock Grid.Column="3" Text="Estado" Style="{StaticResource MutedText}" FontSize="11" Margin="8" />
            <TextBlock Grid.Column="4" Text="Vence" Style="{StaticResource MutedText}" FontSize="11" Margin="8" />
            <TextBlock Grid.Column="5" Text="Acciones" Style="{StaticResource MutedText}" FontSize="11" Margin="8" />
          </Grid>

           <Border Grid.Row="2"
                   Margin="14,10,14,0"
                   Padding="10"
                   Background="{StaticResource BrushPrimaryContainer}"
                   CornerRadius="6"
                   Visibility="{Binding SelectedQuote, Converter={StaticResource NullToVisibilityConverter}}">
             <Grid>
               <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*" />
                 <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>
               <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBody}">
                 <Run Text="Cotización seleccionada: " />
                 <Run Text="{Binding SelectedQuote.QuoteNumber}" FontWeight="SemiBold" />
               </TextBlock>
               <Button Grid.Column="1"
                       Content="Realizar venta"
                       Command="{Binding ConvertToSaleCommand}"
                       CommandParameter="{Binding SelectedQuote}"
                       IsEnabled="{Binding SelectedQuote.CanConvertToSale}"
                       Style="{StaticResource PrimaryButton}" />
             </Grid>
           </Border>

           <ScrollViewer Grid.Row="3">
             <ListBox ItemsSource="{Binding Quotes}"
                      SelectedItem="{Binding SelectedQuote, Mode=TwoWay}"
                      BorderThickness="0"
                      Background="Transparent"
                      HorizontalContentAlignment="Stretch">
               <ListBox.ItemContainerStyle>
                 <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                   <Setter Property="Padding" Value="0" />
                   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                 </Style>
               </ListBox.ItemContainerStyle>
               <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="170" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding QuoteNumber}" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalFormatted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StatusChipKind}" Value="success">
                                <Setter Property="Background" Value="{StaticResource BrushSuccessContainer}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StatusChipKind}" Value="warning">
                                <Setter Property="Background" Value="{StaticResource BrushWarningContainer}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StatusChipKind}" Value="error">
                                <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TextCaption}" FontWeight="Medium" />
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding ExpiresAt}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="PDF"
                                Background="Transparent" BorderBrush="Transparent" Padding="4"
                                Command="{Binding DataContext.ExportPdfCommand, ElementName=HistorialTabRoot}"
                                CommandParameter="{Binding}">
                          <materialDesign:PackIcon Kind="FilePdfBox" Foreground="{StaticResource BrushMuted}" Width="16" Height="16" />
                        </Button>
                        <Button ToolTip="Email"
                                Background="Transparent" BorderBrush="Transparent" Padding="4"
                                Command="{Binding DataContext.SendByEmailCommand, ElementName=HistorialTabRoot}"
                                CommandParameter="{Binding}">
                          <materialDesign:PackIcon Kind="Email" Foreground="{StaticResource BrushMuted}" Width="16" Height="16" />
                        </Button>
                        <Button ToolTip="WhatsApp"
                                Background="Transparent" BorderBrush="Transparent" Padding="4"
                                Command="{Binding DataContext.SendByWhatsAppCommand, ElementName=HistorialTabRoot}"
                                CommandParameter="{Binding}">
                          <materialDesign:PackIcon Kind="WhatsApp" Foreground="{StaticResource BrushMuted}" Width="16" Height="16" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
               </ListBox.ItemTemplate>
             </ListBox>
           </ScrollViewer>

           <Grid Grid.Row="4" Margin="14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="← Anterior" Command="{Binding PreviousPageCommand}" Style="{StaticResource GhostQuoteButton}" />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat="Página {0} · {1} total">
                  <Binding Path="CurrentPage" />
                  <Binding Path="TotalCount" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <Button Grid.Column="2" Content="Siguiente →" Command="{Binding NextPageCommand}" Style="{StaticResource PrimaryButton}" />
          </Grid>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}"
              Visibility="{Binding Converter={StaticResource InverseNullToVisibilityConverter}}">
        <TextBlock Text="Quote history is not available in this environment." Style="{StaticResource MutedText}" Margin="14" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
