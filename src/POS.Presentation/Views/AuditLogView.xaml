<UserControl x:Class="POS.Presentation.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Auditoría" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <Button Content="Actualizar" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" HorizontalAlignment="Left" />
        <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="160" />
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120" />
            <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="90" />
            <DataGridTextColumn Header="Entidad" Binding="{Binding EntityName}" Width="130" />
            <DataGridTextColumn Header="Detalle" Binding="{Binding Details}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
