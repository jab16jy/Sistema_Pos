<UserControl x:Class="POS.Presentation.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
    <SolidColorBrush x:Key="BrushAccent" Color="#0D9488" />
  </UserControl.Resources>

  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Auditoría" Style="{StaticResource TextH1}" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Usuario" Style="{StaticResource MutedText}" />
            <TextBox Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Acción" Style="{StaticResource MutedText}" />
            <ComboBox ItemsSource="{Binding AvailableActionFilters}" SelectedItem="{Binding SelectedActionFilter}" />
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Entidad" Style="{StaticResource MutedText}" />
            <ComboBox ItemsSource="{Binding AvailableEntityFilters}" SelectedItem="{Binding SelectedEntityFilter}" />
          </StackPanel>
          <Button Content="Aplicar filtros" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,14,8,8" />
          <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}" Margin="0,14,0,8" />
        </WrapPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="140" />
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120" />
            <DataGridTextColumn Header="Acción" Binding="{Binding ActionLabel}" Width="110" />
            <DataGridTextColumn Header="Módulo / registro" Binding="{Binding EntityLabel}" Width="170" />
            <DataGridTextColumn Header="Detalle" Binding="{Binding Details}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Paginación -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Logs.Count, StringFormat='{}{0} evento(s) en esta página'}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding PreviousPageCommand}" Style="{StaticResource PrimaryButton}" Padding="6,0" Margin="0,0,8,0">
            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" />
          </Button>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock.Text>
              <MultiBinding StringFormat="Página {0}">
                <Binding Path="CurrentPage" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Button Grid.Column="3" Command="{Binding NextPageCommand}" Style="{StaticResource PrimaryButton}" Padding="6,0">
            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
