<UserControl x:Class="POS.Presentation.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Auditoría" Style="{StaticResource TextH1}" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <WrapPanel Margin="0,0,0,12">
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Usuario" Style="{StaticResource MutedText}" />
            <TextBox Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Acción" Style="{StaticResource MutedText}" />
            <ComboBox ItemsSource="{Binding AvailableActionFilters}" SelectedItem="{Binding SelectedActionFilter}" />
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Entidad" Style="{StaticResource MutedText}" />
            <ComboBox ItemsSource="{Binding AvailableEntityFilters}" SelectedItem="{Binding SelectedEntityFilter}" />
          </StackPanel>
          <Button Content="Aplicar filtros" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,14,8,8" />
          <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}" Margin="0,14,0,8" />
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="160" />
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120" />
            <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="90" />
            <DataGridTextColumn Header="Entidad" Binding="{Binding EntityName}" Width="130" />
            <DataGridTextColumn Header="Detalle" Binding="{Binding Details}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
