<UserControl x:Class="POS.Presentation.Views.BarcodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Codigos de Barras y Etiquetas" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Generar Codigo" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox Text="{Binding BarcodeValue, UpdateSourceTrigger=PropertyChanged}" Tag="Valor del codigo de barras" Margin="0,0,0,8" />
          <Button Content="Generar Vista Previa" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
          <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="120" HorizontalAlignment="Center">
            <Image Source="{Binding PreviewImageBytes, Converter={StaticResource BytesToImageSourceConverter}}" Stretch="Uniform" MaxWidth="300" MaxHeight="120" />
          </Border>
          <TextBlock Text="Impresion" FontWeight="SemiBold" Margin="0,16,0,8" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Copias" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
              <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Imprimir Etiqueta" Command="{Binding PrintSingleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Imprimir Por Categoria" Command="{Binding PrintBulkCommand}" />
          </StackPanel>
          <TextBlock Text="Cargando..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Productos Seleccionados" FontWeight="SemiBold" Margin="0,0,0,12" />
          <DataGrid ItemsSource="{Binding SelectedProducts}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    MaxHeight="500">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" Width="100" />
              <DataGridTextColumn Header="Codigo" Binding="{Binding Barcode}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
