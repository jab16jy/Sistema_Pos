<UserControl x:Class="POS.Presentation.Views.BarcodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ══ LEFT: Generador ══ -->
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18"
                                     Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Generador" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,12">

            <Border Background="{StaticResource BrushPrimaryContainer}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
              <TextBlock TextWrapping="Wrap" Style="{StaticResource TextSmall}" Foreground="{StaticResource BrushPrimary}">
                Utilidad administrativa. Normalmente se abre desde Productos o Admin.
              </TextBlock>
            </Border>

            <TextBlock Text="Valor del c&#243;digo de barras" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding BarcodeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="7770001234567" Margin="0,0,0,12" />

            <TextBlock Text="Formato" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <ComboBox SelectedValue="{Binding SelectedFormat, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,0,0,12">
              <ComboBoxItem Content="CODE 128" />
              <ComboBoxItem Content="EAN-13" />
              <ComboBoxItem Content="CODE 39" />
              <ComboBoxItem Content="QR Code" />
            </ComboBox>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Etiqueta" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding LabelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Producto" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Precio (opcional)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding LabelPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="0" />
              </StackPanel>
            </Grid>

            <TextBlock Text="N&#250;mero de copias" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <TextBox Text="{Binding Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <!-- Live preview -->
            <TextBlock Text="Vista previa" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
            <Border Background="{StaticResource BrushSurfaceContainer}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" MinHeight="140">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding PreviewLabel}" FontWeight="Bold" Style="{StaticResource TextSmall}" HorizontalAlignment="Center" />

                <Image Source="{Binding PreviewImageBytes, Converter={StaticResource BytesToImageSourceConverter}}"
                       Visibility="{Binding PreviewImageBytes, Converter={StaticResource NullToVisibilityConverter}}"
                       Stretch="Uniform" MaxWidth="240" MaxHeight="80" Margin="0,8,0,0" />

                <TextBlock Text="{Binding BarcodeValue}" FontFamily="Consolas" Style="{StaticResource TextBody}" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="Ingresa un valor para previsualizar" Style="{StaticResource MutedText}" FontSize="11"
                           Margin="0,8,0,0" HorizontalAlignment="Center"
                           Visibility="{Binding HasPreview, Converter={StaticResource BooleanNegationToVisibilityConverter}}" />

                <TextBlock Text="{Binding PreviewPriceFormatted}" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource TextH3}"
                           Margin="0,4,0,0" HorizontalAlignment="Center"
                           Visibility="{Binding HasPreviewPrice, Converter={StaticResource BoolToVisibilityConverter}}" />
              </StackPanel>
            </Border>

            <Button Command="{Binding GenerateCommand}" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Generar imagen de c&#243;digo" />
              </StackPanel>
            </Button>

            <!-- Actions -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Command="{Binding PrintSingleCommand}" Background="Transparent"
                      BorderBrush="{StaticResource BrushPrimary}" Foreground="{StaticResource BrushPrimary}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Imprimir" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Command="{Binding AddToBatchCommand}" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Agregar" />
                </StackPanel>
              </Button>
            </Grid>

            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12"
                       Foreground="{StaticResource BrushSuccess}"
                       Visibility="{Binding Message, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}"
                       Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ══ RIGHT: Lote de impresion ══ -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18"
                                     Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Lote de impresi&#243;n" Style="{StaticResource TextBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="2" Style="{StaticResource ChipStyle}" Padding="6,2" Margin="0,0,8,0">
              <TextBlock Style="{StaticResource TextCaption}" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}">
                <Run Text="{Binding BatchItemCount, Mode=OneWay}" />
                <Run Text=" &#237;tems" />
              </TextBlock>
            </Border>
            <Button Grid.Column="3" Command="{Binding PrintBulkCommand}" Style="{StaticResource PrimaryButton}"
                    Padding="10,0" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="Imprimir lote" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding ClearBatchCommand}" Background="Transparent" BorderThickness="0"
                    Padding="4" ToolTip="Vaciar lote">
              <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16" Foreground="{StaticResource BrushMuted}" />
            </Button>
          </Grid>
        </Border>

        <!-- Catalog search -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding CatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Tag="Buscar producto del cat&#225;logo para agregar al lote..." />
          <Button Grid.Column="1" Command="{Binding SearchCatalogCommand}" Padding="8,0" Margin="8,0,0,0" ToolTip="Buscar">
            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" />
          </Button>
        </Grid>

        <!-- Search results -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding CatalogSearchResults}" Margin="16,8,16,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Barcode}" Style="{StaticResource MutedText}" FontSize="11" FontFamily="Consolas" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat='{}${0:N0}'}" FontFamily="Consolas"
                             FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                  <Button Grid.Column="2"
                          Command="{Binding DataContext.AddCatalogItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Background="Transparent" BorderThickness="0" Padding="4" ToolTip="Agregar al lote">
                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="{StaticResource BrushPrimary}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Batch items -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding BatchItems}" Margin="16,8,16,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetaLine}" Style="{StaticResource MutedText}" FontSize="11" FontFamily="Consolas" />
                    </StackPanel>

                    <!-- Copies stepper -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                      <Button Command="{Binding DataContext.DecrementBatchItemCopiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4">
                        <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" />
                      </Button>
                      <TextBlock Text="{Binding Copies}" FontFamily="Consolas" FontWeight="Bold" MinWidth="24"
                                 TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Command="{Binding DataContext.IncrementBatchItemCopiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4">
                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" />
                      </Button>
                    </StackPanel>

                    <!-- Remove -->
                    <Button Grid.Column="2"
                            Command="{Binding DataContext.RemoveBatchItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="4" ToolTip="Eliminar">
                      <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource BrushDanger}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasBatchItems, Converter={StaticResource BooleanNegationToVisibilityConverter}}">
          <materialDesign:PackIcon Kind="BarcodeScan" Width="36" Height="36"
                                    Foreground="{StaticResource BrushBorder}" HorizontalAlignment="Center" />
          <TextBlock Text="Agrega productos para imprimir etiquetas en lote" Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
